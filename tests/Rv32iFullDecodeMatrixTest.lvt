namespace Eccelerators.RiscV.Tests

using Eccelerators.RiscV.Core
using Eccelerators.RiscV.Isa

@Test
component Rv32iFullDecodeMatrixTest
{
	decoder: Rv32iControlDecoder

	new()
	{
		this.decoder = new Rv32iControlDecoder()
	}

	fn AssertLegal(instruction: uint, classKind: int)
	{
		this.decoder.Decode(instruction)
		assert this.decoder.IsLegal() == true
		assert this.decoder.GetInstructionClass() == classKind
	}

	@Test
	fn TestDecodesEveryRv32iInstructionClass()
	{
		this.AssertLegal(0x123450b7, Rv32iControlDecoder.CLASS_LUI) // lui x1, 0x12345
		this.AssertLegal(0x00001117, Rv32iControlDecoder.CLASS_AUIPC) // auipc x2, 0x1
		this.AssertLegal(0x008001ef, Rv32iControlDecoder.CLASS_JAL) // jal x3, +8
		this.AssertLegal(0x001082e7, Rv32iControlDecoder.CLASS_JALR) // jalr x5, 1(x1)
		this.AssertLegal(0x00208463, Rv32iControlDecoder.CLASS_BRANCH) // beq x1, x2, +8
		assert this.decoder.GetBranchKind() == Rv32iBranchUnit.BRANCH_BEQ
		this.AssertLegal(0x00209463, Rv32iControlDecoder.CLASS_BRANCH) // bne x1, x2, +8
		assert this.decoder.GetBranchKind() == Rv32iBranchUnit.BRANCH_BNE
		this.AssertLegal(0x0020c463, Rv32iControlDecoder.CLASS_BRANCH) // blt x1, x2, +8
		assert this.decoder.GetBranchKind() == Rv32iBranchUnit.BRANCH_BLT
		this.AssertLegal(0x0020d463, Rv32iControlDecoder.CLASS_BRANCH) // bge x1, x2, +8
		assert this.decoder.GetBranchKind() == Rv32iBranchUnit.BRANCH_BGE
		this.AssertLegal(0x0020e463, Rv32iControlDecoder.CLASS_BRANCH) // bltu x1, x2, +8
		assert this.decoder.GetBranchKind() == Rv32iBranchUnit.BRANCH_BLTU
		this.AssertLegal(0x0020f463, Rv32iControlDecoder.CLASS_BRANCH) // bgeu x1, x2, +8
		assert this.decoder.GetBranchKind() == Rv32iBranchUnit.BRANCH_BGEU
		this.AssertLegal(0x00008103, Rv32iControlDecoder.CLASS_LOAD) // lb x2, 0(x1)
		this.AssertLegal(0x00009103, Rv32iControlDecoder.CLASS_LOAD) // lh x2, 0(x1)
		this.AssertLegal(0x0000a103, Rv32iControlDecoder.CLASS_LOAD) // lw x2, 0(x1)
		this.AssertLegal(0x0000c103, Rv32iControlDecoder.CLASS_LOAD) // lbu x2, 0(x1)
		this.AssertLegal(0x0000d103, Rv32iControlDecoder.CLASS_LOAD) // lhu x2, 0(x1)
		this.AssertLegal(0x00208023, Rv32iControlDecoder.CLASS_STORE) // sb x2, 0(x1)
		this.AssertLegal(0x00209023, Rv32iControlDecoder.CLASS_STORE) // sh x2, 0(x1)
		this.AssertLegal(0x0020a023, Rv32iControlDecoder.CLASS_STORE) // sw x2, 0(x1)
		this.AssertLegal(0x00500093, Rv32iControlDecoder.CLASS_ALU_IMM) // addi x1, x0, 5
		this.AssertLegal(0x0060a113, Rv32iControlDecoder.CLASS_ALU_IMM) // slti x2, x1, 6
		this.AssertLegal(0x0060b193, Rv32iControlDecoder.CLASS_ALU_IMM) // sltiu x3, x1, 6
		this.AssertLegal(0x0030c213, Rv32iControlDecoder.CLASS_ALU_IMM) // xori x4, x1, 3
		this.AssertLegal(0x0020e293, Rv32iControlDecoder.CLASS_ALU_IMM) // ori x5, x1, 2
		this.AssertLegal(0x0070f313, Rv32iControlDecoder.CLASS_ALU_IMM) // andi x6, x1, 7
		this.AssertLegal(0x00209393, Rv32iControlDecoder.CLASS_ALU_IMM) // slli x7, x1, 2
		this.AssertLegal(0x0013d413, Rv32iControlDecoder.CLASS_ALU_IMM) // srli x8, x7, 1
		this.AssertLegal(0x40155493, Rv32iControlDecoder.CLASS_ALU_IMM) // srai x9, x10, 1
		this.AssertLegal(0x002081b3, Rv32iControlDecoder.CLASS_ALU_REG) // add x3, x1, x2
		this.AssertLegal(0x40208233, Rv32iControlDecoder.CLASS_ALU_REG) // sub x4, x1, x2
		this.AssertLegal(0x002092b3, Rv32iControlDecoder.CLASS_ALU_REG) // sll x5, x1, x2
		this.AssertLegal(0x0020a333, Rv32iControlDecoder.CLASS_ALU_REG) // slt x6, x1, x2
		this.AssertLegal(0x0020b3b3, Rv32iControlDecoder.CLASS_ALU_REG) // sltu x7, x1, x2
		this.AssertLegal(0x0020c433, Rv32iControlDecoder.CLASS_ALU_REG) // xor x8, x1, x2
		this.AssertLegal(0x0020d4b3, Rv32iControlDecoder.CLASS_ALU_REG) // srl x9, x1, x2
		this.AssertLegal(0x4020d533, Rv32iControlDecoder.CLASS_ALU_REG) // sra x10, x1, x2
		this.AssertLegal(0x0020e5b3, Rv32iControlDecoder.CLASS_ALU_REG) // or x11, x1, x2
		this.AssertLegal(0x0020f633, Rv32iControlDecoder.CLASS_ALU_REG) // and x12, x1, x2
		this.AssertLegal(0x0000000f, Rv32iControlDecoder.CLASS_FENCE) // fence
		this.AssertLegal(0x00000073, Rv32iControlDecoder.CLASS_ECALL) // ecall
		this.AssertLegal(0x00100073, Rv32iControlDecoder.CLASS_EBREAK) // ebreak
	}

	@Test
	fn TestRejectsIllegalFunctEncodings()
	{
		this.decoder.Decode(0x02209393)
		assert this.decoder.IsLegal() == false
		this.decoder.Decode(0x0210d413)
		assert this.decoder.IsLegal() == false
		this.decoder.Decode(0x022081b3)
		assert this.decoder.IsLegal() == false
	}
}
