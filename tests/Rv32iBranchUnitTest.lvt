namespace Eccelerators.RiscV.Tests

using Eccelerators.RiscV.Core

/**
 * Checks branch predicates and target-address calculations.
 * Stateful scenarios initialize their inputs independently before execution.
 */
@Test
component Rv32iBranchUnitTest
{
	// Owned subjects and fixtures; scenarios initialize mutable state before use.
	branches: Rv32iBranchUnit

	/**
	 * Constructs the owned subjects and fixtures; each stateful scenario supplies its own initialization.
	 */
	new()
	{
		branches = new Rv32iBranchUnit()
	}

	/**
	 * Checks both outcomes of equality and inequality branches.
	 */
	@Test
	fn TestEqualityBranches()
	{
		assert branches.IsTaken(Rv32iBranchUnit.BRANCH_BEQ, 5, 5) == true
		assert branches.IsTaken(Rv32iBranchUnit.BRANCH_BNE, 5, 6) == true
		assert branches.IsTaken(Rv32iBranchUnit.BRANCH_BEQ, 5, 6) == false
	}

	/**
	 * Uses negative bit patterns to distinguish signed and unsigned branch decisions.
	 */
	@Test
	fn TestSignedAndUnsignedBranches()
	{
		assert branches.IsTaken(Rv32iBranchUnit.BRANCH_BLT, (0xffffffff as uint), 1) == true
		assert branches.IsTaken(Rv32iBranchUnit.BRANCH_BGE, 1, (0xffffffff as uint)) == true
		assert branches.IsTaken(Rv32iBranchUnit.BRANCH_BLTU, (0xffffffff as uint), 1) == false
		assert branches.IsTaken(Rv32iBranchUnit.BRANCH_BGEU, (0xffffffff as uint), 1) == true
	}
}
