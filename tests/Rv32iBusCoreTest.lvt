namespace Eccelerators.RiscV.Tests

using Eccelerators.RiscV.Core
using Eccelerators.RiscV.Isa

/**
 * Checks the reference core with its owned instruction and data buses.
 * Stateful scenarios initialize their inputs independently before execution.
 */
@Test
component Rv32iBusCoreTest
{
	// Owned subjects and fixtures; scenarios initialize mutable state before use.
	core: Rv32iBusCore

	/**
	 * Constructs the owned subjects and fixtures; each stateful scenario supplies its own initialization.
	 */
	new()
	{
		core = new Rv32iBusCore()
	}

	/**
	 * Clears the program/data fixtures and resets CPU state before an independent scenario.
	 */
	fn Prepare()
	{
		core.ClearProgram()
		core.ClearData()
		core.Reset()
	}

	/**
	 * Checks program execution and a visible load/store result through the supplied bus fixtures.
	 */
	@Test
	fn TestRunsThroughInstructionAndDataBuses()
	{
		Prepare()
		core.LoadInstruction(0, 0x04400093)
		core.LoadInstruction(1, 0x00102023)
		core.LoadInstruction(2, 0x00002103)
		core.LoadInstruction(3, 0x00100073)
		core.Run(8)
		assert core.ReadRegister(1) == 0x44
		assert core.ReadRegister(2) == 0x44
		assert core.ReadDataByte(0) == 0x44
		assert core.GetTrapCause() == Rv32iConstants.TRAP_EBREAK
	}

	/**
	 * Checks control flow and diagnostic handling of a rejected data transaction.
	 */
	@Test
	fn TestBranchAndBusErrorPaths()
	{
		Prepare()
		core.LoadInstruction(0, 0x00100093)
		core.LoadInstruction(1, 0x00100113)
		core.LoadInstruction(2, 0x00208463)
		core.LoadInstruction(3, 0x06300193)
		core.LoadInstruction(4, 0x00100073)
		core.Run(8)
		assert core.ReadRegister(3) == 0
		assert core.GetTrapCause() == Rv32iConstants.TRAP_EBREAK
		Prepare()
		core.LoadInstruction(0, 0x12c00093)
		core.LoadInstruction(1, 0x00100113)
		core.LoadInstruction(2, 0x0020a023)
		core.Run(8)
		assert core.GetTrapCause() == Rv32iConstants.TRAP_BUS_ERROR
	}

	/**
	 * Checks PC-relative arithmetic and jump-link values using a fresh program.
	 */
	@Test
	fn TestAuipcAndJal()
	{
		Prepare()
		core.LoadInstruction(0, 0x00001097)
		core.LoadInstruction(1, 0x0080016f)
		core.LoadInstruction(2, 0x06300193)
		core.LoadInstruction(3, 0x00700213)
		core.LoadInstruction(4, 0x00100073)
		core.Run(10)
		assert core.ReadRegister(1) == 0x1000
		assert core.ReadRegister(2) == 8
		assert core.ReadRegister(3) == 0
		assert core.ReadRegister(4) == 7
		assert core.GetTrapCause() == Rv32iConstants.TRAP_EBREAK
	}

	/**
	 * Runs immediate arithmetic, bitwise, comparison and shift cases against expected register values.
	 */
	@Test
	fn TestImmediateAluInstructions()
	{
		Prepare()
		core.LoadInstruction(0, 0x00500093)
		core.LoadInstruction(1, 0x0060a113)
		core.LoadInstruction(2, 0x0060b193)
		core.LoadInstruction(3, 0x0030c213)
		core.LoadInstruction(4, 0x0020e293)
		core.LoadInstruction(5, 0x0070f313)
		core.LoadInstruction(6, 0x00209393)
		core.LoadInstruction(7, 0x0013d413)
		core.LoadInstruction(8, 0xff800513)
		core.LoadInstruction(9, 0x40155493)
		core.LoadInstruction(10, 0x00100073)
		core.Run(16)
		assert core.ReadRegister(1) == 5
		assert core.ReadRegister(2) == 1
		assert core.ReadRegister(3) == 1
		assert core.ReadRegister(4) == 6
		assert core.ReadRegister(5) == 7
		assert core.ReadRegister(6) == 5
		assert core.ReadRegister(7) == 20
		assert core.ReadRegister(8) == 10
		assert core.ReadRegister(9) == (0xfffffffc as uint)
		assert core.GetTrapCause() == Rv32iConstants.TRAP_EBREAK
	}

	/**
	 * Runs register arithmetic, bitwise, comparison and shift cases against expected register values.
	 */
	@Test
	fn TestRegisterAluInstructions()
	{
		Prepare()
		core.LoadInstruction(0, 0x00800093)
		core.LoadInstruction(1, 0x00300113)
		core.LoadInstruction(2, 0x002081b3)
		core.LoadInstruction(3, 0x40208233)
		core.LoadInstruction(4, 0x002092b3)
		core.LoadInstruction(5, 0x0020a333)
		core.LoadInstruction(6, 0x0020b3b3)
		core.LoadInstruction(7, 0x0020c433)
		core.LoadInstruction(8, 0x0020d4b3)
		core.LoadInstruction(9, 0x4020d533)
		core.LoadInstruction(10, 0x0020e5b3)
		core.LoadInstruction(11, 0x0020f633)
		core.LoadInstruction(12, 0x00100073)
		core.Run(18)
		assert core.ReadRegister(3) == 11
		assert core.ReadRegister(4) == 5
		assert core.ReadRegister(5) == 64
		assert core.ReadRegister(6) == 0
		assert core.ReadRegister(7) == 0
		assert core.ReadRegister(8) == 11
		assert core.ReadRegister(9) == 1
		assert core.ReadRegister(10) == 1
		assert core.ReadRegister(11) == 11
		assert core.ReadRegister(12) == 0
		assert core.GetTrapCause() == Rv32iConstants.TRAP_EBREAK
	}

	/**
	 * Checks narrow lane updates, sign extension and untouched data bytes.
	 */
	@Test
	fn TestLoadStoreEdges()
	{
		Prepare()
		core.LoadInstruction(0, 0xfff00093)
		core.LoadInstruction(1, 0x00100023)
		core.LoadInstruction(2, 0x00000103)
		core.LoadInstruction(3, 0x00004183)
		core.LoadInstruction(4, 0xfff00213)
		core.LoadInstruction(5, 0x00401123)
		core.LoadInstruction(6, 0x00201283)
		core.LoadInstruction(7, 0x00205303)
		core.LoadInstruction(8, 0x00100073)
		core.Run(14)
		assert core.ReadRegister(2) == (0xffffffff as uint)
		assert core.ReadRegister(3) == 0xff
		assert core.ReadRegister(5) == (0xffffffff as uint)
		assert core.ReadRegister(6) == 0xffff
		assert core.ReadDataByte(0) == 0xff
		assert core.ReadDataByte(2) == 0xff
		assert core.ReadDataByte(3) == 0xff
		assert core.GetTrapCause() == Rv32iConstants.TRAP_EBREAK
	}

	/**
	 * Checks backward branch offsets and JALR low-bit normalization.
	 */
	@Test
	fn TestNegativeBranchAndJalrLowBitClear()
	{
		Prepare()
		core.LoadInstruction(0, 0x00000093)
		core.LoadInstruction(1, 0x00300113)
		core.LoadInstruction(2, 0x00108093)
		core.LoadInstruction(3, 0xfe209ee3)
		core.LoadInstruction(4, 0x01800093)
		core.LoadInstruction(5, 0x001082e7)
		core.LoadInstruction(6, 0x04d00313)
		core.LoadInstruction(7, 0x00100073)
		core.Run(24)
		assert core.ReadRegister(1) == 24
		assert core.ReadRegister(5) == 24
		assert core.ReadRegister(6) == 77
		assert core.GetTrapCause() == Rv32iConstants.TRAP_EBREAK
	}

	/**
	 * Checks FENCE completion followed by a misaligned load diagnostic.
	 */
	@Test
	fn TestFenceAndMisalignedLoadTrap()
	{
		Prepare()
		core.LoadInstruction(0, 0x0000000f)
		core.LoadInstruction(1, 0x00100093)
		core.LoadInstruction(2, 0x00009103)
		core.Run(8)
		assert core.GetTrapCause() == Rv32iConstants.TRAP_LOAD_STORE_MISALIGNED
		assert core.GetTrapPc() == 8
	}

	/**
	 * Checks that bad jump/branch targets save the source instruction PC and suppress invalid effects.
	 */
	@Test
	fn TestMisalignedControlTransferTargetsTrapAtSource()
	{
		Prepare()
		core.LoadInstruction(0, 0x002000ef)
		core.Run(2)
		assert core.GetTrapCause() == Rv32iConstants.TRAP_INSTRUCTION_MISALIGNED
		assert core.GetTrapPc() == 0
		assert core.GetPc() == 0
		assert core.ReadRegister(1) == 0

		Prepare()
		core.LoadInstruction(0, 0x00200093)
		core.LoadInstruction(1, 0x00008167)
		core.Run(3)
		assert core.GetTrapCause() == Rv32iConstants.TRAP_INSTRUCTION_MISALIGNED
		assert core.GetTrapPc() == 4
		assert core.GetPc() == 4
		assert core.ReadRegister(2) == 0

		Prepare()
		core.LoadInstruction(0, 0x00000163)
		core.Run(2)
		assert core.GetTrapCause() == Rv32iConstants.TRAP_INSTRUCTION_MISALIGNED
		assert core.GetTrapPc() == 0
		assert core.GetPc() == 0
	}
}
