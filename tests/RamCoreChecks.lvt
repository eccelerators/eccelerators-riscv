namespace Eccelerators.RiscV.Tests

using Eccelerators.RiscV.Bus
using Eccelerators.RiscV.Core
using Eccelerators.RiscV.Isa

/**
 * Checks instruction execution and restart with a selected RAM register file.
 */
component RamCoreChecks<STORAGE: Rv32iRegisterStorage>
{
	// Owned buses supplied to the selected execution engine.
	instructions: Rv32SimpleInstructionRom
	data: Rv32SimpleDataRam
	core: Rv32iInjectedBusCore<STORAGE>

	/**
	 * Wires the core to the owned instruction and data memories.
	 */
	new()
	{
		this.instructions = new Rv32SimpleInstructionRom()
		this.data = new Rv32SimpleDataRam()
		this.core = new Rv32iInjectedBusCore<STORAGE>(this.instructions, this.data)
	}

	/**
	 * Executes dependent ALU/load/store/branch operations and repeats after reset.
	 */
	public fn Check()
	{
		this.instructions.Clear()
		this.data.Clear()
		this.core.Reset()
		this.instructions.LoadInstruction(0, 0x04400093) // addi x1, x0, 0x44
		this.instructions.LoadInstruction(1, 0x00102023) // sw x1, 0(x0)
		this.instructions.LoadInstruction(2, 0x00002103) // lw x2, 0(x0)
		this.instructions.LoadInstruction(3, 0x00110193) // addi x3, x2, 1
		this.instructions.LoadInstruction(4, 0x00118463) // beq x3, x1, +8 (not taken)
		this.instructions.LoadInstruction(5, 0x00700013) // addi x0, x0, 7 (discard)
		this.instructions.LoadInstruction(6, 0x00100073) // ebreak
		this.core.Run(12)
		assert this.core.ReadRegister(0) == (0 as uint)
		assert this.core.ReadRegister(1) == (0x44 as uint)
		assert this.core.ReadRegister(2) == (0x44 as uint)
		assert this.core.ReadRegister(3) == (0x45 as uint)
		assert this.core.GetTrapCause() == Rv32iConstants.TRAP_EBREAK
		assert this.data.ReadDataByte(0) == 0x44
		this.core.Reset()
		assert this.core.GetPc() == (0 as uint)
		assert !this.core.IsHalted()

		for (var index = 0; index < 32; index++) {
			assert this.core.ReadRegister(index) == (0 as uint)
		}

		assert this.data.ReadDataByte(0) == 0x44
		this.core.Run(12)
		assert this.core.ReadRegister(3) == (0x45 as uint)
		assert this.core.GetTrapCause() == Rv32iConstants.TRAP_EBREAK
	}
}
