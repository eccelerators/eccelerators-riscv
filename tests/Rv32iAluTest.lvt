namespace Eccelerators.RiscV.Tests

using Eccelerators.RiscV.Core

/**
 * Checks integer arithmetic, logical operations and shift behavior.
 * Stateful scenarios initialize their inputs independently before execution.
 */
@Test
component Rv32iAluTest
{
	// Owned subjects and fixtures; scenarios initialize mutable state before use.
	alu: Rv32iAlu

	/**
	 * Constructs the owned subjects and fixtures; each stateful scenario supplies its own initialization.
	 */
	new()
	{
		alu = new Rv32iAlu()
	}

	/**
	 * Checks arithmetic and bitwise results against independent scalar expectations.
	 */
	@Test
	fn TestArithmeticAndLogic()
	{
		assert alu.Execute(Rv32iAlu.OP_ADD, 7, 5) == 12
		assert alu.Execute(Rv32iAlu.OP_SUB, 7, 5) == 2
		assert alu.Execute(Rv32iAlu.OP_AND, 0x0f, 0x33) == 0x03
		assert alu.Execute(Rv32iAlu.OP_OR, 0x0f, 0x30) == 0x3f
		assert alu.Execute(Rv32iAlu.OP_XOR, 0x0f, 0x33) == 0x3c
	}

	/**
	 * Checks shift direction, sign fill and the difference between signed and unsigned comparisons.
	 */
	@Test
	fn TestShiftsAndComparisons()
	{
		assert alu.Execute(Rv32iAlu.OP_SLL, 1, 3) == 8
		assert alu.Execute(Rv32iAlu.OP_SRL, 8, 1) == 4
		assert alu.Execute(Rv32iAlu.OP_SRA, (0x80000000 as uint), 1) == (0xc0000000 as uint)
		assert alu.Execute(Rv32iAlu.OP_SLT, (0xffffffff as uint), 1) == 1
		assert alu.Execute(Rv32iAlu.OP_SLTU, (0xffffffff as uint), 1) == 0
	}
}
