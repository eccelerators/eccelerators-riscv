namespace Eccelerators.RiscV.Tests

using Eccelerators.RiscV.Core
using Eccelerators.RiscV.Isa

@Test
component Rv32iCoreInstructionTest
{
	core: Rv32iReferenceCore

	new()
	{
		this.core = new Rv32iReferenceCore()
	}

	fn Prepare()
	{
		this.core.ClearProgram()
		this.core.ClearData()
		this.core.Reset()
	}

	@Test
	fn TestUpperImmediateAndAluProgram()
	{
		this.Prepare()
		this.core.LoadInstruction(0, 0x123450b7)
		this.core.LoadInstruction(1, 0x00001117)
		this.core.LoadInstruction(2, 0x00508193)
		this.core.LoadInstruction(3, 0x00308233)
		this.core.LoadInstruction(4, 0x00100073)
		this.core.Run(10)
		assert this.core.ReadRegister(1) == (0x12345000 as uint)
		assert this.core.ReadRegister(2) == (0x00001004 as uint)
		assert this.core.ReadRegister(3) == (0x12345005 as uint)
		assert this.core.ReadRegister(4) == (0x2468a005 as uint)
		assert this.core.GetTrapCause() == Rv32iConstants.TRAP_EBREAK
	}

	@Test
	fn TestBranchAndJumpProgram()
	{
		this.Prepare()
		this.core.LoadInstruction(0, 0x00100093)
		this.core.LoadInstruction(1, 0x00100113)
		this.core.LoadInstruction(2, 0x00208463)
		this.core.LoadInstruction(3, 0x06300193)
		this.core.LoadInstruction(4, 0x0080026f)
		this.core.LoadInstruction(5, 0x04d00293)
		this.core.LoadInstruction(6, 0x00100073)
		this.core.Run(12)
		assert this.core.ReadRegister(3) == 0
		assert this.core.ReadRegister(4) == 20
		assert this.core.ReadRegister(5) == 0
		assert this.core.GetTrapCause() == Rv32iConstants.TRAP_EBREAK
	}

	@Test
	fn TestMemoryProgram()
	{
		this.Prepare()
		this.core.LoadInstruction(0, 0x04400093)
		this.core.LoadInstruction(1, 0x00102023)
		this.core.LoadInstruction(2, 0x00002103)
		this.core.LoadInstruction(3, 0x00000183)
		this.core.LoadInstruction(4, 0x00004203)
		this.core.LoadInstruction(5, 0x00100073)
		this.core.Run(12)
		assert this.core.ReadRegister(2) == 0x44
		assert this.core.ReadRegister(3) == 0x44
		assert this.core.ReadRegister(4) == 0x44
		assert this.core.ReadDataByte(0) == 0x44
		assert this.core.GetTrapCause() == Rv32iConstants.TRAP_EBREAK
	}

	@Test
	fn TestEcallAndMisalignedLoadTrap()
	{
		this.Prepare()
		this.core.LoadInstruction(0, 0x00000073)
		this.core.Run(2)
		assert this.core.GetTrapCause() == Rv32iConstants.TRAP_ECALL
		this.Prepare()
		this.core.LoadInstruction(0, 0x00102103)
		this.core.Run(2)
		assert this.core.GetTrapCause() == Rv32iConstants.TRAP_LOAD_STORE_MISALIGNED
	}

	@Test
	fn TestOutOfRangeLoadTrapsBeforeMemoryAccess()
	{
		this.Prepare()
		this.core.LoadInstruction(0, 0x10000093)
		this.core.LoadInstruction(1, 0x0000a103)
		this.core.Run(4)
		assert this.core.GetTrapCause() == Rv32iConstants.TRAP_BUS_ERROR
		assert this.core.GetTrapPc() == 4
		assert this.core.ReadRegister(2) == 0
	}

	@Test
	fn TestMisalignedControlTransferTargetsTrapAtSource()
	{
		this.Prepare()
		this.core.LoadInstruction(0, 0x002000ef)
		this.core.Run(2)
		assert this.core.GetTrapCause() == Rv32iConstants.TRAP_INSTRUCTION_MISALIGNED
		assert this.core.GetTrapPc() == 0
		assert this.core.GetPc() == 0
		assert this.core.ReadRegister(1) == 0

		this.Prepare()
		this.core.LoadInstruction(0, 0x00200093)
		this.core.LoadInstruction(1, 0x00008167)
		this.core.Run(3)
		assert this.core.GetTrapCause() == Rv32iConstants.TRAP_INSTRUCTION_MISALIGNED
		assert this.core.GetTrapPc() == 4
		assert this.core.GetPc() == 4
		assert this.core.ReadRegister(2) == 0

		this.Prepare()
		this.core.LoadInstruction(0, 0x00000163)
		this.core.Run(2)
		assert this.core.GetTrapCause() == Rv32iConstants.TRAP_INSTRUCTION_MISALIGNED
		assert this.core.GetTrapPc() == 0
		assert this.core.GetPc() == 0
	}
}
