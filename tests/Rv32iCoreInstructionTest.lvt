namespace Eccelerators.RiscV.Tests

using Eccelerators.RiscV.Core
using Eccelerators.RiscV.Isa

/**
 * Checks architectural effects of individual instructions in the reference core.
 * Stateful scenarios initialize their inputs independently before execution.
 */
@Test
component Rv32iCoreInstructionTest
{
	// Owned subjects and fixtures; scenarios initialize mutable state before use.
	core: Rv32iReferenceCore

	/**
	 * Constructs the owned subjects and fixtures; each stateful scenario supplies its own initialization.
	 */
	new()
	{
		core = new Rv32iReferenceCore()
	}

	/**
	 * Clears the program/data fixtures and resets CPU state before an independent scenario.
	 */
	fn Prepare()
	{
		core.ClearProgram()
		core.ClearData()
		core.Reset()
	}

	/**
	 * Runs an independently provisioned program and checks upper-immediate and integer results.
	 */
	@Test
	fn TestUpperImmediateAndAluProgram()
	{
		Prepare()
		core.LoadInstruction(0, 0x123450b7)
		core.LoadInstruction(1, 0x00001117)
		core.LoadInstruction(2, 0x00508193)
		core.LoadInstruction(3, 0x00308233)
		core.LoadInstruction(4, 0x00100073)
		core.Run(10)
		assert core.ReadRegister(1) == (0x12345000 as uint)
		assert core.ReadRegister(2) == (0x00001004 as uint)
		assert core.ReadRegister(3) == (0x12345005 as uint)
		assert core.ReadRegister(4) == (0x2468a005 as uint)
		assert core.GetTrapCause() == Rv32iConstants.TRAP_EBREAK
	}

	/**
	 * Checks branch/jump redirection and link-register results in a bounded program.
	 */
	@Test
	fn TestBranchAndJumpProgram()
	{
		Prepare()
		core.LoadInstruction(0, 0x00100093)
		core.LoadInstruction(1, 0x00100113)
		core.LoadInstruction(2, 0x00208463)
		core.LoadInstruction(3, 0x06300193)
		core.LoadInstruction(4, 0x0080026f)
		core.LoadInstruction(5, 0x04d00293)
		core.LoadInstruction(6, 0x00100073)
		core.Run(12)
		assert core.ReadRegister(3) == 0
		assert core.ReadRegister(4) == 20
		assert core.ReadRegister(5) == 0
		assert core.GetTrapCause() == Rv32iConstants.TRAP_EBREAK
	}

	/**
	 * Checks load/store effects through the reference core using a freshly provisioned program.
	 */
	@Test
	fn TestMemoryProgram()
	{
		Prepare()
		core.LoadInstruction(0, 0x04400093)
		core.LoadInstruction(1, 0x00102023)
		core.LoadInstruction(2, 0x00002103)
		core.LoadInstruction(3, 0x00000183)
		core.LoadInstruction(4, 0x00004203)
		core.LoadInstruction(5, 0x00100073)
		core.Run(12)
		assert core.ReadRegister(2) == 0x44
		assert core.ReadRegister(3) == 0x44
		assert core.ReadRegister(4) == 0x44
		assert core.ReadDataByte(0) == 0x44
		assert core.GetTrapCause() == Rv32iConstants.TRAP_EBREAK
	}

	/**
	 * Checks diagnostic ECALL and misaligned-load stops after independent initialization.
	 */
	@Test
	fn TestEcallAndMisalignedLoadTrap()
	{
		Prepare()
		core.LoadInstruction(0, 0x00000073)
		core.Run(2)
		assert core.GetTrapCause() == Rv32iConstants.TRAP_ECALL
		Prepare()
		core.LoadInstruction(0, 0x00102103)
		core.Run(2)
		assert core.GetTrapCause() == Rv32iConstants.TRAP_LOAD_STORE_MISALIGNED
	}

	/**
	 * Requires an out-of-range load to halt with the expected saved PC.
	 */
	@Test
	fn TestOutOfRangeLoadTrapsBeforeMemoryAccess()
	{
		Prepare()
		core.LoadInstruction(0, 0x10000093)
		core.LoadInstruction(1, 0x0000a103)
		core.Run(4)
		assert core.GetTrapCause() == Rv32iConstants.TRAP_BUS_ERROR
		assert core.GetTrapPc() == 4
		assert core.ReadRegister(2) == 0
	}

	/**
	 * Checks that bad jump/branch targets save the source instruction PC and suppress invalid effects.
	 */
	@Test
	fn TestMisalignedControlTransferTargetsTrapAtSource()
	{
		Prepare()
		core.LoadInstruction(0, 0x002000ef)
		core.Run(2)
		assert core.GetTrapCause() == Rv32iConstants.TRAP_INSTRUCTION_MISALIGNED
		assert core.GetTrapPc() == 0
		assert core.GetPc() == 0
		assert core.ReadRegister(1) == 0

		Prepare()
		core.LoadInstruction(0, 0x00200093)
		core.LoadInstruction(1, 0x00008167)
		core.Run(3)
		assert core.GetTrapCause() == Rv32iConstants.TRAP_INSTRUCTION_MISALIGNED
		assert core.GetTrapPc() == 4
		assert core.GetPc() == 4
		assert core.ReadRegister(2) == 0

		Prepare()
		core.LoadInstruction(0, 0x00000163)
		core.Run(2)
		assert core.GetTrapCause() == Rv32iConstants.TRAP_INSTRUCTION_MISALIGNED
		assert core.GetTrapPc() == 0
		assert core.GetPc() == 0
	}
}
