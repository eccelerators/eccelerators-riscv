namespace Eccelerators.RiscV.Tests

using Eccelerators.RiscV.Core
using Livt.IO

/**
 * Shared architectural checks for each compile-time register implementation.
 */
component RegisterStorageChecks<STORAGE: Rv32iRegisterStorage>
{
	// Selected register file under test, owned by this check component.
	registers: IRv32iRegisterFile

	/**
	 * Constructs the selected storage in the test context.
	 */
	new()
	{
		static if (STORAGE == Rv32iRegisterStorage.Array) {
			registers = new Rv32iRegisterFile()
		} elif (STORAGE == Rv32iRegisterStorage.DistributedRam) {
			registers = new Rv32iRamRegisterFile<MemoryStyle.Distributed>()
		} else {
			registers = new Rv32iRamRegisterFile<MemoryStyle.Block>()
		}
	}

	/**
	 * Checks all writable registers, unsigned high bits, x0, bounds, and reset.
	 */
	public fn Check()
	{
		registers.Reset()

		for (var index = 1; index < 32; index++) {
			var expected: uint = (0x80000000 as uint) | (index as uint)
			registers.Write(index, expected)
			assert registers.Read(index) == expected
		}

		for (var index = 1; index < 32; index++) {
			var expected: uint = (0x80000000 as uint) | (index as uint)
			assert registers.Read(index) == expected
		}

		registers.Write(0, 99)
		registers.Write(-1, 99)
		registers.Write(32, 99)
		assert registers.Read(0) == (0 as uint)
		assert registers.Read(-1) == (0 as uint)
		assert registers.Read(32) == (0 as uint)
		registers.Reset()

		for (var index = 0; index < 32; index++) {
			assert registers.Read(index) == (0 as uint)
		}
	}
}
