namespace Eccelerators.RiscV.Tests

using Eccelerators.RiscV.Bus
using Eccelerators.RiscV.Core
using Eccelerators.RiscV.Platform
using Eccelerators.RiscV.Isa

/**
 * Checks the public reference-core API through its exported namespace.
 * Stateful scenarios initialize their inputs independently before execution.
 */
@Test
component Rv32iPackageApiTest
{
	// Owned subjects and fixtures; scenarios initialize mutable state before use.
	system: Rv32iMinimalSystem
	busCore: Rv32iBusCore
	uartSystem: Rv32iUartMmioSystem
	rom: Rv32SimpleInstructionRom
	ram: Rv32SimpleDataRam

	/**
	 * Constructs the owned subjects and fixtures; each stateful scenario supplies its own initialization.
	 */
	new()
	{
		system = new Rv32iMinimalSystem()
		busCore = new Rv32iBusCore()
		uartSystem = new Rv32iUartMmioSystem()
		rom = new Rv32SimpleInstructionRom()
		ram = new Rv32SimpleDataRam()
	}

	/**
	 * Constructs the public reference APIs and verifies independent register, memory and UART outcomes.
	 */
	@Test
	fn TestDocumentedEntryPointsAreUsable()
	{
		system.ClearProgram()
		system.ClearData()
		system.Reset()
		assert Rv32iMinimalSystem.PROGRAM_WORDS == 64
		assert Rv32iMinimalSystem.DATA_BYTES == 256
		system.LoadInstruction(0, 0x04400093)
		system.LoadInstruction(1, 0x00100073)
		system.Run(4)
		assert system.ReadRegister(1) == 0x44
		assert system.GetTrapCause() == Rv32iConstants.TRAP_EBREAK
		rom.Clear()
		rom.LoadInstruction(0, 0x00100073)
		rom.Request(0)
		assert rom.GetInstruction() == (0x00100073 as uint)
		ram.Clear()
		ram.Store(0, 4, 0x00000044)
		ram.Load(0, 4, false)
		assert ram.GetReadData() == 0x44
		busCore.ClearProgram()
		busCore.ClearData()
		busCore.Reset()
		busCore.LoadInstruction(0, 0x05500093)
		busCore.LoadInstruction(1, 0x00100073)
		busCore.Run(4)
		assert busCore.ReadRegister(1) == 0x55
		assert busCore.GetTrapCause() == Rv32iConstants.TRAP_EBREAK
		uartSystem.ClearProgram()
		uartSystem.ClearData()
		uartSystem.Reset()
		uartSystem.LoadInstruction(0, 0x400000b7)
		uartSystem.LoadInstruction(1, 0x05a00113)
		uartSystem.LoadInstruction(2, 0x00208023)
		uartSystem.LoadInstruction(3, 0x00100073)
		uartSystem.Run(8)
		assert uartSystem.GetCapturedUartCount() == 1
		assert uartSystem.GetCapturedUartByte(0) == 0x5a
		assert uartSystem.GetTrapCause() == Rv32iConstants.TRAP_EBREAK
	}
}
