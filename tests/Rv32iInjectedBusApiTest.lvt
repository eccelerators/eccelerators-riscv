namespace Eccelerators.RiscV.Tests

using Eccelerators.RiscV.Bus
using Eccelerators.RiscV.Core
using Eccelerators.RiscV.Isa

/**
 * Checks execution and transaction counts with caller-supplied buses.
 * Stateful scenarios initialize their inputs independently before execution.
 */
@Test
component Rv32iInjectedBusApiTest
{
	// Owned subjects and fixtures; scenarios initialize mutable state before use.
	core: Rv32iInjectedBusCore
	instructionBus: Rv32SimpleInstructionRom
	dataBus: Rv32TestDataBus

	/**
	 * Constructs the owned subjects and fixtures; each stateful scenario supplies its own initialization.
	 */
	new()
	{
		instructionBus = new Rv32SimpleInstructionRom()
		dataBus = new Rv32TestDataBus()
		core = new Rv32iInjectedBusCore(instructionBus, dataBus)
	}

	/**
	 * Clears program memory and loads a store/load program ending in EBREAK.
	 * The caller separately resets the CPU and data-bus probe.
	 */
	fn LoadStoreProgram()
	{
		instructionBus.Clear()
		instructionBus.LoadInstruction(0, 0x02a00093)
		instructionBus.LoadInstruction(1, 0x00102023)
		instructionBus.LoadInstruction(2, 0x00002103)
		instructionBus.LoadInstruction(3, 0x00100073)
	}

	/**
	 * Checks the stored value and transaction counts of the caller-owned bus probe.
	 */
	@Test
	fn TestCoreRunsWithCallerOwnedDataBus()
	{
		dataBus.Clear()
		LoadStoreProgram()
		core.Reset()
		core.Run(8)
		assert dataBus.GetStoreCount() == 1
		assert dataBus.GetLoadCount() == 1
		assert dataBus.GetStoredValue() == 0x2a
		assert core.ReadRegister(1) == 0x2a
		assert core.ReadRegister(2) == 0x2a
		assert core.GetTrapCause() == Rv32iConstants.TRAP_EBREAK
	}

	/**
	 * Requires misaligned accesses to halt without incrementing the bus probe transaction counters.
	 */
	@Test
	fn TestMisalignedDataAccessTrapsBeforeBusRequest()
	{
		instructionBus.Clear()
		dataBus.Clear()
		core.Reset()
		instructionBus.LoadInstruction(0, 0x00102103) // lw x2, 1(x0)
		core.Run(2)
		assert core.GetTrapCause() == Rv32iConstants.TRAP_LOAD_STORE_MISALIGNED
		assert core.GetTrapPc() == 0
		assert dataBus.GetLoadCount() == 0

		instructionBus.Clear()
		dataBus.Clear()
		core.Reset()
		instructionBus.LoadInstruction(0, 0x001010a3) // sh x1, 1(x0)
		core.Run(2)
		assert core.GetTrapCause() == Rv32iConstants.TRAP_LOAD_STORE_MISALIGNED
		assert core.GetTrapPc() == 0
		assert dataBus.GetStoreCount() == 0
	}

	/**
	 * Checks that bad jump/branch targets save the source instruction PC and suppress invalid effects.
	 */
	@Test
	fn TestMisalignedControlTransferTargetsTrapAtSource()
	{
		instructionBus.Clear()
		dataBus.Clear()
		core.Reset()
		instructionBus.LoadInstruction(0, 0x002000ef)
		core.Run(2)
		assert core.GetTrapCause() == Rv32iConstants.TRAP_INSTRUCTION_MISALIGNED
		assert core.GetTrapPc() == 0
		assert core.GetPc() == 0
		assert core.ReadRegister(1) == 0

		instructionBus.Clear()
		dataBus.Clear()
		core.Reset()
		instructionBus.LoadInstruction(0, 0x00200093)
		instructionBus.LoadInstruction(1, 0x00008167)
		core.Run(3)
		assert core.GetTrapCause() == Rv32iConstants.TRAP_INSTRUCTION_MISALIGNED
		assert core.GetTrapPc() == 4
		assert core.GetPc() == 4
		assert core.ReadRegister(2) == 0

		instructionBus.Clear()
		dataBus.Clear()
		core.Reset()
		instructionBus.LoadInstruction(0, 0x00000163)
		core.Run(2)
		assert core.GetTrapCause() == Rv32iConstants.TRAP_INSTRUCTION_MISALIGNED
		assert core.GetTrapPc() == 0
		assert core.GetPc() == 0
	}
}
