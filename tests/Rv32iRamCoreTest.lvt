namespace Eccelerators.RiscV.Tests

using Eccelerators.RiscV.Core

/**
 * Verifies the supported storage configurations independently.
 */
@Test
component Rv32iRamCoreTest
{
	// Independently owned subjects; each Check explicitly resets its state.
	distributedRamChecks: RamCoreChecks<Rv32iRegisterStorage.DistributedRam>
	blockRamChecks: RamCoreChecks<Rv32iRegisterStorage.BlockRam>

	/**
	 * Constructs the supported configurations.
	 */
	new()
	{
		distributedRamChecks = new RamCoreChecks<Rv32iRegisterStorage.DistributedRam>()
		blockRamChecks = new RamCoreChecks<Rv32iRegisterStorage.BlockRam>()
	}

	/**
	 * Checks architectural behavior with DistributedRam storage.
	 */
	@Test
	fn PreservesBehaviorWithDistributedRam()
	{
		distributedRamChecks.Check()
	}

	/**
	 * Checks architectural behavior with BlockRam storage.
	 */
	@Test
	fn PreservesBehaviorWithBlockRam()
	{
		blockRamChecks.Check()
	}
}
