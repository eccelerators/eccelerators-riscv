namespace Eccelerators.RiscV.Tests

using Eccelerators.RiscV.Bus
using Eccelerators.RiscV.Core
using Eccelerators.RiscV.Isa
using Eccelerators.RiscV.Platform

/**
 * Checks a complete instruction program writing bytes through the UART system.
 * Stateful scenarios initialize their inputs independently before execution.
 */
@Test
component Rv32iUartHelloWorldTest
{
	// Owned subjects and fixtures; scenarios initialize mutable state before use.
	system: Rv32iUartMmioSystem
	bus: Rv32UartMmioDataBus

	/**
	 * Constructs the owned subjects and fixtures; each stateful scenario supplies its own initialization.
	 */
	new()
	{
		system = new Rv32iUartMmioSystem()
		bus = new Rv32UartMmioDataBus()
	}

	/**
	 * Clears the program/data fixtures and resets CPU state before an independent scenario.
	 */
	fn Prepare()
	{
		system.ClearProgram()
		system.ClearData()
		system.Reset()
	}

	/**
	 * Provisions a bounded program that enqueues the greeting through UART MMIO and halts.
	 */
	fn LoadHelloProgram()
	{
		system.LoadInstruction(0, 0x400000b7)
		system.LoadInstruction(1, 0x04800113)
		system.LoadInstruction(2, 0x00208023)
		system.LoadInstruction(3, 0x06500113)
		system.LoadInstruction(4, 0x00208023)
		system.LoadInstruction(5, 0x06c00113)
		system.LoadInstruction(6, 0x00208023)
		system.LoadInstruction(7, 0x06c00113)
		system.LoadInstruction(8, 0x00208023)
		system.LoadInstruction(9, 0x06f00113)
		system.LoadInstruction(10, 0x00208023)
		system.LoadInstruction(11, 0x00a00113)
		system.LoadInstruction(12, 0x00208023)
		system.LoadInstruction(13, 0x00100073)
	}

	/**
	 * Runs greeting firmware and checks each byte accepted by the UART MMIO capture.
	 */
	@Test
	fn TestHelloWorldWritesCharactersToUartMmio()
	{
		Prepare()
		LoadHelloProgram()
		system.Run(32)
		assert system.GetTrapCause() == Rv32iConstants.TRAP_EBREAK
		assert system.IsHalted() == true
		assert system.GetCapturedUartCount() == 6
		assert system.GetCapturedUartByte(0) == 0x48
		assert system.GetCapturedUartByte(1) == 0x65
		assert system.GetCapturedUartByte(2) == 0x6c
		assert system.GetCapturedUartByte(3) == 0x6c
		assert system.GetCapturedUartByte(4) == 0x6f
		assert system.GetCapturedUartByte(5) == 0x0a
		assert system.GetUartStatus() == 1
		assert system.HasDataBusError() == false
	}

	/**
	 * Checks PC-relative control flow and the resulting UART byte in an independent program.
	 */
	@Test
	fn TestUartPlatformRunsAuipcJalrStyleProgram()
	{
		Prepare()
		system.LoadInstruction(0, 0x00000297)
		system.LoadInstruction(1, 0x00c28067)
		system.LoadInstruction(2, 0x02100113)
		system.LoadInstruction(3, 0x400000b7)
		system.LoadInstruction(4, 0x04100113)
		system.LoadInstruction(5, 0x00208023)
		system.LoadInstruction(6, 0x00100073)
		system.Run(16)
		assert system.GetTrapCause() == Rv32iConstants.TRAP_EBREAK
		assert system.IsHalted() == true
		assert system.GetCapturedUartCount() == 1
		assert system.GetCapturedUartByte(0) == 0x41
		assert system.ReadRegister(2) == 0x41
		assert system.HasDataBusError() == false
	}

	/**
	 * Checks unsupported UART addresses and widths report errors through the data bus.
	 */
	@Test
	fn TestUartMmioRejectsUnsupportedAccesses()
	{
		bus.Clear()
		bus.Store(Rv32UartMmioDataBus.UART_TX_ADDRESS, Rv32iLoadStoreUnit.WIDTH_WORD, 0x41)
		assert bus.HasError() == true
		bus.Load(Rv32UartMmioDataBus.UART_TX_ADDRESS, Rv32iLoadStoreUnit.WIDTH_BYTE, false)
		assert bus.HasError() == true
		bus.Load(Rv32UartMmioDataBus.UART_STATUS_ADDRESS, Rv32iLoadStoreUnit.WIDTH_WORD, false)
		assert bus.HasError() == false
		assert bus.GetReadData() == 1
		bus.Store(0x50000000, Rv32iLoadStoreUnit.WIDTH_BYTE, 0x41)
		assert bus.HasError() == true
		bus.LoadDataByte(0, 0x5a)
		bus.Load(Rv32UartMmioDataBus.RAM_BASE, -1, false)
		assert bus.HasError() == true
		bus.Store(Rv32UartMmioDataBus.RAM_BASE, 0, 0xaa)
		assert bus.HasError() == true
		assert bus.ReadDataByte(0) == 0x5a
		bus.Store(Rv32UartMmioDataBus.RAM_BASE, 3, 0xccbbaa)
		assert bus.HasError() == true
		assert bus.ReadDataByte(0) == 0x5a
	}

	/**
	 * Checks RAM transactions at the public mapped base and rejection outside the window.
	 */
	@Test
	fn TestMappedRamUsesDocumentedDataBase()
	{
		bus.Clear()
		bus.Store(Rv32UartMmioDataBus.RAM_BASE, Rv32iLoadStoreUnit.WIDTH_WORD, 0x44332211)
		assert bus.HasError() == false
		assert bus.ReadDataByte(0) == 0x11
		assert bus.ReadDataByte(1) == 0x22
		assert bus.ReadDataByte(2) == 0x33
		assert bus.ReadDataByte(3) == 0x44
		bus.Load(Rv32UartMmioDataBus.RAM_BASE, Rv32iLoadStoreUnit.WIDTH_WORD, false)
		assert bus.GetReadData() == (0x44332211 as uint)
		assert bus.HasError() == false
	}

	/**
	 * Checks that mapped helper addresses translate to the same RAM bytes seen by the CPU.
	 */
	@Test
	fn TestUartSystemMappedDataHelpersUseDocumentedDataBase()
	{
		Prepare()
		system.LoadMappedDataByte(Rv32UartMmioDataBus.RAM_BASE, 0x5a)
		assert system.ReadMappedDataByte(Rv32UartMmioDataBus.RAM_BASE) == 0x5a
		assert system.ReadDataByte(0) == 0x5a
	}

	/**
	 * Waits for serial loopback delivery, including a zero byte, then checks receive occupancy and empty behavior.
	 */
	@Test
	fn TestUartBytesReachLoopbackReceiver()
	{
		bus.Clear()
		bus.Store(Rv32UartMmioDataBus.UART_TX_ADDRESS, Rv32iLoadStoreUnit.WIDTH_BYTE, 0xa5)
		assert bus.HasError() == false
		bus.Store(Rv32UartMmioDataBus.UART_TX_ADDRESS, Rv32iLoadStoreUnit.WIDTH_BYTE, 0x00)
		assert bus.HasError() == false

		// Bound the wait while the physical UART serializes and receives both frames.
		var attempts = 0

		while (bus.GetUartAvailableBytes() < 2 && attempts < 20000) {
			attempts++
		}

		assert bus.GetUartAvailableBytes() == 2
		assert bus.ReceiveUartByte() == 0xa5
		assert bus.ReceiveUartByte() == 0x00
		assert bus.GetUartAvailableBytes() == 0
		assert bus.ReceiveUartByte() == 0x00
	}
}
