namespace Eccelerators.RiscV.Tests

using Eccelerators.RiscV.Core
using Eccelerators.RiscV.Storage
using Eccelerators.RiscV.Presets

/**
 * Instruction-level checks observe committed writes independently of CPU storage.
 * Every wait is bounded so a stalled bus or controller fails the test.
 */
@Test
component Rv32PipelineEngineTest
{
	// Owned platform, preset and architectural observation scoreboard.
	fetch: RvFetchRom<256, 8>
	loadStore: RvLoadStoreRam<256, 8>
	core: Rv32iPipelineCore
	observed: uint[32]
	retireCount: uint
	clearObservation: bool
	cycles: uint
	tracePc: uint[512]
	traceWord: uint[512]
	traceRd: uint[512]
	traceValue: uint[512]

	/**
	 * Creates distinct instruction and data providers in the test clock context.
	 */
	new()
	{
		fetch = new RvFetchRom<256, 8>()
		loadStore = new RvLoadStoreRam<256, 8>()
		core = new Rv32iPipelineCore(fetch, loadStore)
	}

	/**
	 * Samples retirement every clock; tests never read a CPU-private register array.
	 */
	process Observe()
	{
		state {
			cycles++

			if (clearObservation) {
				retireCount = 0
			} elif (core.retired == 0b1) {
				assert retireCount < 512
				tracePc[retireCount] = core.retiredPc as uint
				traceWord[retireCount] = core.retiredInstruction as uint
				traceRd[retireCount] = core.retiredRd as uint
				traceValue[retireCount] = core.retiredValue as uint
				retireCount++

				if (core.retiredRd != 0) {
					observed[core.retiredRd as uint] = core.retiredValue as uint
				}
			}
		}
	}

	/**
	 * Programs one word with the CPU paused; writes are sampled once.
	 */
	fn Load(index: uint, word: uint)
	{
		state {
			fetch.programWrite = 0b1
			fetch.programIndex = index as logic[8]
			fetch.programData = word as logic[32]
		}

		state {
			fetch.programWrite = 0b0
		}
	}

	/**
	 * Runs to a fault stop and bounds uninterrupted cycles per retired instruction.
	 */
	fn RunToStop(cause: uint)
	{
		var start = cycles
		core.run = 0b1

		while (core.halted == 0b0 && cycles - start < 20000) {
			state {}
		}

		core.run = 0b0
		assert core.halted == 0b1
		assert core.faultCause as uint == cause
		assert cycles - start < retireCount * 50 + 50
	}

	/**
	 * Exercises dependent arithmetic, x0 suppression and exact retirement count.
	 */
	@Test
	fn TestDependentArithmetic()
	{
		Prepare()
		Load(0, 0x00500093)
		Load(1, 0x00308113)
		Load(2, 0x002081b3)
		Load(3, 0x07b00013)
		Load(4, 0x00000213)
		Load(5, 0x00100073)
		RunToStop(3)
		assert observed[1] == 5
		assert observed[2] == 8
		assert observed[3] == 13
		assert observed[4] == 0
		assert retireCount == 5
		assert core.pc == 20
	}

	/**
	 * Initializes every data location that a vector can read before execution.
	 */
	fn Prepare()
	{
		core.run = 0b0
		Simulation.Wait(40)
		assert core.idle == 0b1
		var ticket = ~core.restartAck
		core.restartRequest = ticket
		var elapsed: uint = 0

		while (core.restartAck != ticket && elapsed < 100) {
			state {
				elapsed++
			}
		}

		assert core.restartAck == ticket
		clearObservation = true
		Simulation.Wait(4)
		clearObservation = false

		for (var index: uint = 0; index < 256; index++) {
			state {
				loadStore.programWrite = 0b1
				loadStore.programIndex = index as logic[8]
				loadStore.programData = 0
			}
		}

		state {
			loadStore.programWrite = 0b0
		}

		assert core.idle == 0b1
	}

	/**
	 * Compares one ordered committed event with independently computed constants.
	 */
	fn CheckRetirement(index: uint, pc: uint, word: uint, rd: uint, value: uint)
	{
		assert tracePc[index] == pc
		assert traceWord[index] == word
		assert traceRd[index] == rd
		assert traceValue[index] == value
	}

	// Directed and deterministic randomized instruction/retirement vectors.

	/**
	 * Independent architectural vector: IntegerAndFence.
	 */
	@Test
	fn TestIntegerAndFence()
	{
		Prepare()
		Load(0, 0xfff00093)
		Load(1, 0x01f00113)
		Load(2, 0x800001b7)
		Load(3, 0x12345217)
		Load(4, 0x07b00013)
		Load(5, 0x00208233)
		Load(6, 0xfff18613)
		Load(7, 0x002092b3)
		Load(8, 0x01f19693)
		Load(9, 0x0020a333)
		Load(10, 0xfff1a713)
		Load(11, 0x0020b3b3)
		Load(12, 0xfff1b793)
		Load(13, 0x0020c433)
		Load(14, 0xfff1c813)
		Load(15, 0x0020d4b3)
		Load(16, 0x01f1d893)
		Load(17, 0x0020e533)
		Load(18, 0xfff1e913)
		Load(19, 0x0020f5b3)
		Load(20, 0xfff1f993)
		Load(21, 0x40118a33)
		Load(22, 0x4021dab3)
		Load(23, 0x41f1db13)
		Load(24, 0x4001db93)
		Load(25, 0x02000c13)
		Load(26, 0x01809cb3)
		Load(27, 0x4181dd33)
		Load(28, 0x0ff0000f)
		Load(29, 0x8330808f)
		Load(30, 0x00100073)
		RunToStop(3)
		assert core.pc == 120
		assert core.faultValue == 0x00000078
		assert retireCount == 30
		CheckRetirement(0, 0, 0xfff00093, 1, 0xffffffff)
		CheckRetirement(1, 4, 0x01f00113, 2, 0x0000001f)
		CheckRetirement(2, 8, 0x800001b7, 3, 0x80000000)
		CheckRetirement(3, 12, 0x12345217, 4, 0x1234500c)
		CheckRetirement(4, 16, 0x07b00013, 0, 0x00000000)
		CheckRetirement(5, 20, 0x00208233, 4, 0x0000001e)
		CheckRetirement(6, 24, 0xfff18613, 12, 0x7fffffff)
		CheckRetirement(7, 28, 0x002092b3, 5, 0x80000000)
		CheckRetirement(8, 32, 0x01f19693, 13, 0x00000000)
		CheckRetirement(9, 36, 0x0020a333, 6, 0x00000001)
		CheckRetirement(10, 40, 0xfff1a713, 14, 0x00000001)
		CheckRetirement(11, 44, 0x0020b3b3, 7, 0x00000000)
		CheckRetirement(12, 48, 0xfff1b793, 15, 0x00000001)
		CheckRetirement(13, 52, 0x0020c433, 8, 0xffffffe0)
		CheckRetirement(14, 56, 0xfff1c813, 16, 0x7fffffff)
		CheckRetirement(15, 60, 0x0020d4b3, 9, 0x00000001)
		CheckRetirement(16, 64, 0x01f1d893, 17, 0x00000001)
		CheckRetirement(17, 68, 0x0020e533, 10, 0xffffffff)
		CheckRetirement(18, 72, 0xfff1e913, 18, 0xffffffff)
		CheckRetirement(19, 76, 0x0020f5b3, 11, 0x0000001f)
		CheckRetirement(20, 80, 0xfff1f993, 19, 0x80000000)
		CheckRetirement(21, 84, 0x40118a33, 20, 0x80000001)
		CheckRetirement(22, 88, 0x4021dab3, 21, 0xffffffff)
		CheckRetirement(23, 92, 0x41f1db13, 22, 0xffffffff)
		CheckRetirement(24, 96, 0x4001db93, 23, 0x80000000)
		CheckRetirement(25, 100, 0x02000c13, 24, 0x00000020)
		CheckRetirement(26, 104, 0x01809cb3, 25, 0xffffffff)
		CheckRetirement(27, 108, 0x4181dd33, 26, 0x80000000)
		CheckRetirement(28, 112, 0x0ff0000f, 0, 0x00000000)
		CheckRetirement(29, 116, 0x8330808f, 0, 0x00000000)
	}

