	/**
	 * Independent architectural vector: MultiplyUnavailable.
	 */
	@Test
	fn TestMultiplyUnavailable()
	{
		for (var operation: uint = 0; operation < 4; operation++) {
			Prepare()
			var instruction = 0x020000b3 | (operation << 12)
			Load(0, instruction)
			RunToStop(2)
			assert core.pc == 0
			assert core.faultValue as uint == instruction
			assert retireCount == 0
		}
	}

