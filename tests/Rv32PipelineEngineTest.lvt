	/**
	 * Independent architectural vector: LoopAndJumps.
	 */
	@Test
	fn TestLoopAndJumps()
	{
		Prepare()
		Load(0, 0x00000093)
		Load(1, 0x00300113)
		Load(2, 0x00108093)
		Load(3, 0xfe209ee3)
		Load(4, 0x01800093)
		Load(5, 0x001082e7)
		Load(6, 0x0080036f)
		Load(7, 0x06300393)
		Load(8, 0x04d00413)
		Load(9, 0x00100073)
		RunToStop(3)
		assert core.pc == 36
		assert core.faultValue == 0x00000024
		assert retireCount == 12
		CheckRetirement(0, 0, 0x00000093, 1, 0x00000000)
		CheckRetirement(1, 4, 0x00300113, 2, 0x00000003)
		CheckRetirement(2, 8, 0x00108093, 1, 0x00000001)
		CheckRetirement(3, 12, 0xfe209ee3, 0, 0x00000000)
		CheckRetirement(4, 8, 0x00108093, 1, 0x00000002)
		CheckRetirement(5, 12, 0xfe209ee3, 0, 0x00000000)
		CheckRetirement(6, 8, 0x00108093, 1, 0x00000003)
		CheckRetirement(7, 12, 0xfe209ee3, 0, 0x00000000)
		CheckRetirement(8, 16, 0x01800093, 1, 0x00000018)
		CheckRetirement(9, 20, 0x001082e7, 5, 0x00000018)
		CheckRetirement(10, 24, 0x0080036f, 6, 0x0000001c)
		CheckRetirement(11, 32, 0x04d00413, 8, 0x0000004d)
	}

	/**
	 * Independent architectural vector: MemoryLanes.
	 */
	@Test
	fn TestMemoryLanes()
	{
		Prepare()
		Load(0, 0x89abc0b7)
		Load(1, 0x7ef08093)
		Load(2, 0x00102023)
		Load(3, 0x00000103)
		Load(4, 0x00004303)
		Load(5, 0x00100183)
		Load(6, 0x00104383)
		Load(7, 0x00200203)
		Load(8, 0x00204403)
		Load(9, 0x00300283)
		Load(10, 0x00304483)
		Load(11, 0x00001503)
		Load(12, 0x00205583)
		Load(13, 0xfff00613)
		Load(14, 0x00c00223)
		Load(15, 0x00402683)
		Load(16, 0x00c002a3)
		Load(17, 0x00402703)
		Load(18, 0x00c00323)
		Load(19, 0x00402783)
		Load(20, 0x00c003a3)
		Load(21, 0x00402803)
		Load(22, 0x00101323)
		Load(23, 0x00601883)
		Load(24, 0x00605903)
		Load(25, 0x00402983)
		Load(26, 0x00100073)
		RunToStop(3)
		assert core.pc == 104
		assert core.faultValue == 0x00000068
		assert retireCount == 26
		CheckRetirement(0, 0, 0x89abc0b7, 1, 0x89abc000)
		CheckRetirement(1, 4, 0x7ef08093, 1, 0x89abc7ef)
		CheckRetirement(2, 8, 0x00102023, 0, 0x00000000)
		CheckRetirement(3, 12, 0x00000103, 2, 0xffffffef)
		CheckRetirement(4, 16, 0x00004303, 6, 0x000000ef)
		CheckRetirement(5, 20, 0x00100183, 3, 0xffffffc7)
		CheckRetirement(6, 24, 0x00104383, 7, 0x000000c7)
		CheckRetirement(7, 28, 0x00200203, 4, 0xffffffab)
		CheckRetirement(8, 32, 0x00204403, 8, 0x000000ab)
		CheckRetirement(9, 36, 0x00300283, 5, 0xffffff89)
		CheckRetirement(10, 40, 0x00304483, 9, 0x00000089)
		CheckRetirement(11, 44, 0x00001503, 10, 0xffffc7ef)
		CheckRetirement(12, 48, 0x00205583, 11, 0x000089ab)
		CheckRetirement(13, 52, 0xfff00613, 12, 0xffffffff)
		CheckRetirement(14, 56, 0x00c00223, 0, 0x00000000)
		CheckRetirement(15, 60, 0x00402683, 13, 0x000000ff)
		CheckRetirement(16, 64, 0x00c002a3, 0, 0x00000000)
		CheckRetirement(17, 68, 0x00402703, 14, 0x0000ffff)
		CheckRetirement(18, 72, 0x00c00323, 0, 0x00000000)
		CheckRetirement(19, 76, 0x00402783, 15, 0x00ffffff)
		CheckRetirement(20, 80, 0x00c003a3, 0, 0x00000000)
		CheckRetirement(21, 84, 0x00402803, 16, 0xffffffff)
		CheckRetirement(22, 88, 0x00101323, 0, 0x00000000)
		CheckRetirement(23, 92, 0x00601883, 17, 0xffffc7ef)
		CheckRetirement(24, 96, 0x00605903, 18, 0x0000c7ef)
		CheckRetirement(25, 100, 0x00402983, 19, 0xc7efffff)
	}

	/**
	 * Independent architectural vector: NotTakenMisalignedBranch.
	 */
