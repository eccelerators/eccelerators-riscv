	fn TestNotTakenMisalignedBranch()
	{
		Prepare()
		Load(0, 0x00100093)
		Load(1, 0x00008163)
		Load(2, 0x00100073)
		RunToStop(3)
		assert core.pc == 8
		assert core.faultValue == 0x00000008
		assert retireCount == 2
		CheckRetirement(0, 0, 0x00100093, 1, 0x00000001)
		CheckRetirement(1, 4, 0x00008163, 0, 0x00000000)
	}

