	/**
	 * Independent architectural vector: Branch0Equal0.
	 */
	@Test
	fn TestBranch0Equal0()
	{
		Prepare()
		Load(0, 0xfff00093)
		Load(1, 0x00100113)
		Load(2, 0x00208463)
		Load(3, 0x02a00193)
		Load(4, 0x00100073)
		RunToStop(3)
		assert core.pc == 16
		assert core.faultValue == 0x00000010
		assert retireCount == 4
		CheckRetirement(0, 0, 0xfff00093, 1, 0xffffffff)
		CheckRetirement(1, 4, 0x00100113, 2, 0x00000001)
		CheckRetirement(2, 8, 0x00208463, 0, 0x00000000)
		CheckRetirement(3, 12, 0x02a00193, 3, 0x0000002a)
	}

	/**
	 * Independent architectural vector: Branch0Equal1.
	 */
	@Test
	fn TestBranch0Equal1()
	{
		Prepare()
		Load(0, 0xfff00093)
		Load(1, 0xfff00113)
		Load(2, 0x00208463)
		Load(3, 0x02a00193)
		Load(4, 0x00100073)
		RunToStop(3)
		assert core.pc == 16
		assert core.faultValue == 0x00000010
		assert retireCount == 3
		CheckRetirement(0, 0, 0xfff00093, 1, 0xffffffff)
		CheckRetirement(1, 4, 0xfff00113, 2, 0xffffffff)
		CheckRetirement(2, 8, 0x00208463, 0, 0x00000000)
	}

	/**
	 * Independent architectural vector: Branch1Equal0.
	 */
	@Test
	fn TestBranch1Equal0()
	{
		Prepare()
		Load(0, 0xfff00093)
		Load(1, 0x00100113)
		Load(2, 0x00209463)
		Load(3, 0x02a00193)
		Load(4, 0x00100073)
		RunToStop(3)
		assert core.pc == 16
		assert core.faultValue == 0x00000010
		assert retireCount == 3
		CheckRetirement(0, 0, 0xfff00093, 1, 0xffffffff)
		CheckRetirement(1, 4, 0x00100113, 2, 0x00000001)
		CheckRetirement(2, 8, 0x00209463, 0, 0x00000000)
	}

