namespace Eccelerators.RiscV.Tests

using Eccelerators.RiscV.Isa
using Eccelerators.RiscV.Core

/**
 * Checks legal instruction classes, control outputs and rejected encodings.
 * Stateful scenarios initialize their inputs independently before execution.
 */
@Test
component Rv32iControlDecoderTest
{
	// Owned subjects and fixtures; scenarios initialize mutable state before use.
	decoder: Rv32iControlDecoder

	/**
	 * Constructs the owned subjects and fixtures; each stateful scenario supplies its own initialization.
	 */
	new()
	{
		decoder = new Rv32iControlDecoder()
	}

	/**
	 * Checks representative instruction families and their selected operation fields.
	 */
	@Test
	fn TestDecodesRepresentativeInstructions()
	{
		decoder.Decode(0x123450b7)
		assert decoder.IsLegal() == true
		assert decoder.GetInstructionClass() == Rv32iControlDecoder.CLASS_LUI
		decoder.Decode(0x00208463)
		assert decoder.IsLegal() == true
		assert decoder.GetBranchKind() == Rv32iBranchUnit.BRANCH_BEQ
		decoder.Decode(0x4010d113)
		assert decoder.IsLegal() == true
		assert decoder.GetAluOperation() == Rv32iAlu.OP_SRA
	}

	/**
	 * Requires unsupported instruction bits to leave the decoder illegal.
	 */
	@Test
	fn TestRejectsIllegalInstruction()
	{
		decoder.Decode(0xffffffff)
		assert decoder.IsLegal() == false
	}
}
