namespace Eccelerators.RiscV.Tests

using Eccelerators.RiscV.Core

@Test
component Rv32iLoadStoreUnitTest
{
	unit: Rv32iLoadStoreUnit

	new()
	{
		this.unit = new Rv32iLoadStoreUnit()
	}

	@Test
	fn TestLoadExtraction()
	{
		var word: uint = 0x807f3412
		assert this.unit.ExtractLoad(word, 0, Rv32iLoadStoreUnit.WIDTH_BYTE, false) == 0x12
		assert this.unit.ExtractLoad(word, 1, Rv32iLoadStoreUnit.WIDTH_HALF, false) == 0x7f34
		assert this.unit.ExtractLoad(word, 3, Rv32iLoadStoreUnit.WIDTH_BYTE, true) == (0xffffff80 as uint)
		assert this.unit.ExtractLoad(word, 0, Rv32iLoadStoreUnit.WIDTH_WORD, false) == word
	}

	@Test
	fn TestStoreMergeAndAlignment()
	{
		assert this.unit.MergeStore(0x11223344, 1, Rv32iLoadStoreUnit.WIDTH_BYTE, 0xaa) == (0x1122aa44 as uint)
		assert this.unit.MergeStore(0x11223344, 0, Rv32iLoadStoreUnit.WIDTH_HALF, 0xbeef) == (0x1122beef as uint)
		assert this.unit.IsMisaligned(2, Rv32iLoadStoreUnit.WIDTH_WORD) == true
		assert this.unit.IsMisaligned(4, Rv32iLoadStoreUnit.WIDTH_WORD) == false
	}
}
