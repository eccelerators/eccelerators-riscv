namespace Eccelerators.RiscV.Tests

using Eccelerators.RiscV.Core

/**
 * Checks access alignment, byte lanes and signed load extension.
 * Stateful scenarios initialize their inputs independently before execution.
 */
@Test
component Rv32iLoadStoreUnitTest
{
	// Owned subjects and fixtures; scenarios initialize mutable state before use.
	unit: Rv32iLoadStoreUnit

	/**
	 * Constructs the owned subjects and fixtures; each stateful scenario supplies its own initialization.
	 */
	new()
	{
		unit = new Rv32iLoadStoreUnit()
	}

	/**
	 * Checks byte/halfword selection and sign extension from a fixed little-endian word.
	 */
	@Test
	fn TestLoadExtraction()
	{
		var word: uint = 0x807f3412
		assert unit.ExtractLoad(word, 0, Rv32iLoadStoreUnit.WIDTH_BYTE, false) == 0x12
		assert unit.ExtractLoad(word, 1, Rv32iLoadStoreUnit.WIDTH_HALF, false) == 0x7f34
		assert unit.ExtractLoad(word, 3, Rv32iLoadStoreUnit.WIDTH_BYTE, true) == (0xffffff80 as uint)
		assert unit.ExtractLoad(word, 0, Rv32iLoadStoreUnit.WIDTH_WORD, false) == word
	}

	/**
	 * Checks lane preservation during partial stores and alignment decisions for each width.
	 */
	@Test
	fn TestStoreMergeAndAlignment()
	{
		assert unit.MergeStore(0x11223344, 1, Rv32iLoadStoreUnit.WIDTH_BYTE, 0xaa) == (0x1122aa44 as uint)
		assert unit.MergeStore(0x11223344, 0, Rv32iLoadStoreUnit.WIDTH_HALF, 0xbeef) == (0x1122beef as uint)
		assert unit.IsMisaligned(2, Rv32iLoadStoreUnit.WIDTH_WORD) == true
		assert unit.IsMisaligned(4, Rv32iLoadStoreUnit.WIDTH_WORD) == false
	}
}
