namespace Eccelerators.RiscV.Tests

using Eccelerators.RiscV.Isa
using Eccelerators.RiscV.Platform

/**
 * Checks program provisioning and execution through the minimal system wrapper.
 * Stateful scenarios initialize their inputs independently before execution.
 */
@Test
component Rv32iMinimalSystemTest
{
	// Owned subjects and fixtures; scenarios initialize mutable state before use.
	system: Rv32iMinimalSystem

	/**
	 * Constructs the owned subjects and fixtures; each stateful scenario supplies its own initialization.
	 */
	new()
	{
		system = new Rv32iMinimalSystem()
	}

	/**
	 * Clears the program/data fixtures and resets CPU state before an independent scenario.
	 */
	fn Prepare()
	{
		system.ClearProgram()
		system.ClearData()
		system.Reset()
	}

	/**
	 * Provisions a minimal system and checks its final RAM byte and EBREAK stop.
	 */
	@Test
	fn TestRunsProgramAndStoresVisibleResult()
	{
		Prepare()
		system.LoadInstruction(0, 0x04400093)
		system.LoadInstruction(1, 0x00102023)
		system.LoadInstruction(2, 0x00100073)
		system.Run(8)
		assert system.ReadRegister(1) == 0x44
		assert system.ReadDataByte(0) == 0x44
		assert system.GetTrapCause() == Rv32iConstants.TRAP_EBREAK
		assert system.IsHalted() == true
	}

	/**
	 * Checks published program/data capacities and zero-based helper addressing.
	 */
	@Test
	fn TestDocumentsLocalMemoryShape()
	{
		assert Rv32iMinimalSystem.PROGRAM_WORDS == 64
		assert Rv32iMinimalSystem.DATA_BYTES == 256
		Prepare()
		system.LoadDataByte(0, 0x5a)
		assert system.ReadDataByte(0) == 0x5a
		assert system.ReadDataByte(Rv32iMinimalSystem.DATA_BYTES) == 0x00
	}
}
