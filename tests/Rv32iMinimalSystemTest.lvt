namespace Eccelerators.RiscV.Tests

using Eccelerators.RiscV.Isa
using Eccelerators.RiscV.Platform

@Test
component Rv32iMinimalSystemTest
{
	system: Rv32iMinimalSystem

	new()
	{
		this.system = new Rv32iMinimalSystem()
	}

	fn Prepare()
	{
		this.system.ClearProgram()
		this.system.ClearData()
		this.system.Reset()
	}

	@Test
	fn TestRunsProgramAndStoresVisibleResult()
	{
		this.Prepare()
		this.system.LoadInstruction(0, 0x04400093)
		this.system.LoadInstruction(1, 0x00102023)
		this.system.LoadInstruction(2, 0x00100073)
		this.system.Run(8)
		assert this.system.ReadRegister(1) == 0x44
		assert this.system.ReadDataByte(0) == 0x44
		assert this.system.GetTrapCause() == Rv32iConstants.TRAP_EBREAK
		assert this.system.IsHalted() == true
	}

	@Test
	fn TestDocumentsLocalMemoryShape()
	{
		assert Rv32iMinimalSystem.PROGRAM_WORDS == 64
		assert Rv32iMinimalSystem.DATA_BYTES == 256
		this.Prepare()
		this.system.LoadDataByte(0, 0x5a)
		assert this.system.ReadDataByte(0) == 0x5a
		assert this.system.ReadDataByte(Rv32iMinimalSystem.DATA_BYTES) == 0x00
	}
}
