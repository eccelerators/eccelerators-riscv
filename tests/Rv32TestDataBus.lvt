namespace Eccelerators.RiscV.Tests

using Eccelerators.RiscV.Bus
using Eccelerators.RiscV.Core
using Eccelerators.RiscV.Isa

/**
 * Caller-owned bus probe that counts transactions and retains one word.
 * Serial scheduled accesses ignore address/width to detect missing engine-side validation.
 */
component Rv32TestDataBus : IRv32DataBus
{
	// Probe value and transaction counters expose duplicate or unexpected bus effects.
	storedValue: uint
	loadCount: int
	storeCount: int

	// Response snapshot for the last completed test transaction.
	error: bool
	readData: uint

	/**
	 * Initializes the test value, transaction counters and response state.
	 */
	new()
	{
		Clear()
	}

	/**
	 * Zeros the test value and transaction counters and clears response state for an independent scenario.
	 */
	public fn Clear()
	{
		storedValue = 0
		loadCount = 0
		storeCount = 0
		error = false
		readData = 0
	}

	/**
	 * Counts one completed test load and returns the stored value.
	 * This probe deliberately ignores address, width and signedness to expose engine-side checking.
	 */
	override fn Load(address: uint, width: int, signedLoad: bool)
	{
		error = false
		loadCount++
		readData = storedValue
	}

	/**
	 * Counts one completed test store and replaces the stored value.
	 * This probe deliberately accepts every address/width so invalid engine requests remain observable.
	 */
	override fn Store(address: uint, width: int, value: uint)
	{
		error = false
		storeCount++
		storedValue = value
		readData = 0
	}

	/**
	 * Returns the last completed load result; consume it before another transaction.
	 * Check HasError before treating the value as valid.
	 */
	override fn GetReadData() uint
	{
		return readData
	}

	/**
	 * Reports whether the last completed transaction failed. A new transaction replaces this status.
	 */
	override fn HasError() bool
	{
		return error
	}

	/**
	 * Returns the value of the most recent test-bus store without issuing another transaction.
	 */
	public fn GetStoredValue() uint
	{
		return storedValue
	}

	/**
	 * Returns the number of load calls since Clear, allowing tests to detect unwanted bus requests.
	 */
	public fn GetLoadCount() int
	{
		return loadCount
	}

	/**
	 * Returns the number of store calls since Clear, allowing tests to detect duplicate effects.
	 */
	public fn GetStoreCount() int
	{
		return storeCount
	}
}
