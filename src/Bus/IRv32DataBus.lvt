namespace Eccelerators.RiscV.Bus

/**
 * Synchronous RISC-V data load/store contract for byte, halfword, and word
 * accesses. Load and Store complete before returning.
 *
 * Width must be WIDTH_BYTE, WIDTH_HALF, or WIDTH_WORD from Rv32iLoadStoreUnit.
 * Implementations report unsupported widths through HasError().
 */
interface IRv32DataBus
{
	/**
	 * Completes a load at a byte address using a WIDTH_BYTE, WIDTH_HALF or WIDTH_WORD selector.
	 * Sign-extension applies to narrow signed loads. Consume HasError and GetReadData before
	 * issuing another transaction; providers must reject faults before irreversible effects.
	 */
	fn Load(address: uint, width: int, signedLoad: bool)

	/**
	 * Completes a store of the low width bytes at a byte address. Width must be a
	 * WIDTH_BYTE, WIDTH_HALF or WIDTH_WORD selector. Consume HasError before another
	 * transaction; unsupported accesses must fail before irreversible effects.
	 */
	fn Store(address: uint, width: int, value: uint)

	/**
	 * Returns the last completed load result; consume it before another transaction.
	 * Check HasError before treating the value as valid.
	 */
	fn GetReadData() uint

	/**
	 * Reports whether the last completed transaction failed. A new transaction replaces this status.
	 */
	fn HasError() bool
}
