namespace Eccelerators.RiscV.Bus

using Eccelerators.RiscV.Core
using Livt.IO

/**
 * Owns a mapped RAM and UART loopback fixture for scheduled bus transactions.
 * The UART uses internal loopback, without external serial pins.
 * Calls use the inherited context; serialize bus access, provisioning and clearing.
 */
component Rv32UartMmioDataBus : IRv32DataBus
{
	// Mapped RAM window: inclusive base and exclusive limit.
	public const RAM_BASE: uint = 0x00010000
	public const RAM_LIMIT: uint = 0x00010100

	// UART byte transmit and word status addresses.
	public const UART_TX_ADDRESS: uint = 0x40000000
	public const UART_STATUS_ADDRESS: uint = 0x40000004

	// Maximum accepted transmit bytes retained for inspection.
	public const CAPTURE_BYTES: int = 64

	// Owned RAM and internal serial-loopback peripheral.
	ram: Rv32SimpleDataRam
	uart: LoopbackUart<64, 64>

	// Accepted transmit bytes and next capture position.
	captured: byte[64]
	captureCount: int

	// Response snapshot for the last completed bus transaction.
	error: bool
	readData: uint

	/**
	 * Owns RAM and loopback UART instances in the inherited clock/reset context.
	 * Clears RAM, queues, capture and response state before use.
	 */
	new()
	{
		ram = new Rv32SimpleDataRam()
		uart = new LoopbackUart<64, 64>()
		Clear()
	}

	/**
	 * Clears RAM, queued UART data, receive errors, capture and bus status.
	 * An active or committed serial frame may still complete; coordinate clearing with UART activity.
	 */
	public fn Clear()
	{
		var index: int = 0
		ram.Clear()
		uart.ClearReceiveBuffer()
		uart.ClearTransmitBuffer()
		uart.ClearErrors()

		while (index < CAPTURE_BYTES) {
			captured[index] = 0x00
			index++
		}

		captureCount = 0
		error = false
		readData = 0
	}

	/**
	 * Stores a byte at local RAM offset 0..255; ignores invalid offsets.
	 * Serialize provisioning with CPU accesses; no bus address translation is applied.
	 */
	public fn LoadDataByte(address: int, value: byte)
	{
		ram.LoadDataByte(address, value)
	}

	/**
	 * Returns the byte at local RAM offset 0..255, or zero for an invalid offset.
	 * Read only after any concurrent CPU access has completed.
	 */
	public fn ReadDataByte(address: int) byte
	{
		return ram.ReadDataByte(address)
	}

	/**
	 * Stores one byte at a mapped RAM address in [RAM_BASE, RAM_LIMIT).
	 * Ignores other addresses; serialize provisioning with CPU accesses.
	 */
	public fn LoadMappedDataByte(address: uint, value: byte)
	{
		var translatedAddress: uint = 0

		if (IsRamAddressValid(address, Rv32iLoadStoreUnit.WIDTH_BYTE) == false) {
			return
		}

		translatedAddress = address - RAM_BASE
		ram.LoadDataByte(translatedAddress as int, value)
	}

	/**
	 * Returns a byte from mapped RAM in [RAM_BASE, RAM_LIMIT), or zero outside it.
	 * Serialize inspection with CPU accesses.
	 */
	public fn ReadMappedDataByte(address: uint) byte
	{
		var translatedAddress: uint = 0

		if (IsRamAddressValid(address, Rv32iLoadStoreUnit.WIDTH_BYTE) == false) {
			return 0x00
		}

		translatedAddress = address - RAM_BASE
		return ram.ReadDataByte(translatedAddress as int)
	}

	/**
	 * Returns an accepted transmit byte by index, or zero outside the captured range.
	 * Capture proves enqueue acceptance, not completion of a serial frame.
	 */
	public fn GetCapturedByte(index: int) byte
	{
		if (index < 0) {
			return 0x00
		}

		if (index >= captureCount) {
			return 0x00
		}

		return captured[index]
	}

	/**
	 * Returns the number of accepted bytes retained in the bounded capture buffer.
	 */
	public fn GetCapturedCount() int
	{
		return captureCount
	}

	/**
	 * Returns a snapshot of free transmit queue entries, not a reservation.
	 * The separate capture buffer can still cause a transmit store to be rejected.
	 */
	public fn GetUartTransmitSpace() int
	{
		return uart.GetTransmitSpace()
	}

	/**
	 * Returns a snapshot of queued loopback receive bytes; reading this count consumes nothing.
	 */
	public fn GetUartAvailableBytes() int
	{
		return uart.GetReceiveCount()
	}

	/**
	 * Removes one queued receive byte, or returns zero when empty.
	 * Check receive occupancy first to distinguish an empty queue from a received zero byte.
	 */
	public fn ReceiveUartByte() byte
	{
		var value: byte = 0x00
		uart.TryReceive(value)
		return value
	}

	/**
	 * Completes a mapped RAM load or a word read of UART_STATUS_ADDRESS.
	 * Status reports transmit queue space. Other addresses/widths fail with zero read data.
	 */
	override fn Load(address: uint, width: int, signedLoad: bool)
	{
		var translatedAddress: uint = 0
		error = false
		readData = 0

		if (address == UART_STATUS_ADDRESS) {
			if (width != Rv32iLoadStoreUnit.WIDTH_WORD) {
				error = true
				return
			}

			if (uart.GetTransmitSpace() > 0) {
				readData = 1
				return
			}

			readData = 0
			return
		}

		if (IsRamAddressValid(address, width) == true) {
			translatedAddress = address - RAM_BASE
			ram.Load(translatedAddress, width, signedLoad)
			readData = ram.GetReadData()

			if (ram.HasError() == true) {
				error = true
			}

			return
		}

		error = true
	}

	/**
	 * Completes a mapped RAM store or enqueues one byte at UART_TX_ADDRESS.
	 * A full queue/capture buffer or unsupported access reports error before accepting a byte;
	 * serial-frame completion occurs later and is not promised by this call.
	 */
	override fn Store(address: uint, width: int, value: uint)
	{
		var translatedAddress: uint = 0
		var byteValue: byte = (value & (0xff as uint)) as byte
		var accepted: bool = false
		var captureIndex: int = captureCount
		error = false
		readData = 0

		if (address == UART_TX_ADDRESS) {
			if (width != Rv32iLoadStoreUnit.WIDTH_BYTE) {
				error = true
				return
			}

			if (captureCount >= CAPTURE_BYTES) {
				error = true
				return
			}

			accepted = uart.TryTransmit(byteValue)

			if (accepted == false) {
				error = true
				return
			}

			captured[captureIndex] = byteValue
			captureCount++
			return
		}

		if (IsRamAddressValid(address, width) == true) {
			translatedAddress = address - RAM_BASE
			ram.Store(translatedAddress, width, value)

			if (ram.HasError() == true) {
				error = true
			}

			return
		}

		error = true
	}

	/**
	 * Returns the last completed load result; consume it before another transaction.
	 * Check HasError before treating the value as valid.
	 */
	override fn GetReadData() uint
	{
		return readData
	}

	/**
	 * Reports whether the last completed transaction failed. A new transaction replaces this status.
	 */
	override fn HasError() bool
	{
		return error
	}

	/**
	 * Checks width and the full mapped RAM range before translating the address.
	 * Alignment is checked by the underlying RAM transaction.
	 */
	fn IsRamAddressValid(address: uint, width: int) bool
	{
		var endAddress: uint = 0

		if (IsWidthValid(width) == false) {
			return false
		}

		endAddress = address + (width as uint)

		if (address < RAM_BASE) {
			return false
		}

		if (address >= RAM_LIMIT) {
			return false
		}

		if (endAddress > RAM_LIMIT) {
			return false
		}

		return true
	}

	/**
	 * Accepts only the byte, halfword and word width constants; rejects all other values.
	 */
	fn IsWidthValid(width: int) bool
	{
		if (width == Rv32iLoadStoreUnit.WIDTH_BYTE) {
			return true
		}

		if (width == Rv32iLoadStoreUnit.WIDTH_HALF) {
			return true
		}

		if (width == Rv32iLoadStoreUnit.WIDTH_WORD) {
			return true
		}

		return false
	}
}
