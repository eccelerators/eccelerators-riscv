namespace Eccelerators.RiscV.Bus

/**
 * Owns 64 instruction words with zero-based byte addressing for fetches.
 * Scheduled calls use the inherited context and complete before returning.
 * Provision or clear words only while instruction fetching is stopped.
 */
component Rv32SimpleInstructionRom : IRv32InstructionBus
{
	// Capacity in 32-bit instruction words.
	public const WORD_COUNT: int = 64

	// Owned program storage, provisioned only between fetches.
	words: uint[64]

	// Response snapshot for the last completed fetch.
	error: bool
	instruction: uint

	/**
	 * Creates a zero-filled instruction fixture with cleared response and error state.
	 */
	new()
	{
		Clear()
	}

	/**
	 * Zeros all program words and clears response/error state before returning.
	 * Do not overlap clearing with fetch or provisioning calls.
	 */
	public fn Clear()
	{
		var index: int = 0

		while (index < WORD_COUNT) {
			words[index] = 0
			index++
		}

		error = false
		instruction = 0
	}

	/**
	 * Stores a word at instruction index 0..63; ignores indices outside that range.
	 * Provision only while execution is stopped; this argument is a word index, not a byte address.
	 */
	public fn LoadInstruction(index: int, instruction: uint)
	{
		if (index < 0) {
			return
		}

		if (index >= WORD_COUNT) {
			return
		}

		words[index] = instruction
	}

	/**
	 * Fetches an aligned instruction at byte address 0..255 before returning.
	 * Invalid or misaligned addresses set HasError and return a zero instruction.
	 */
	override fn Request(address: uint)
	{
		var index: int = 0
		error = false
		instruction = 0

		if ((address & (3 as uint)) != (0 as uint)) {
			error = true
			return
		}

		index = (address >> 2) as int

		if (index < 0) {
			error = true
			return
		}

		if (index >= WORD_COUNT) {
			error = true
			return
		}

		instruction = words[index]
	}

	/**
	 * Returns the word from the last completed request; check HasError first.
	 * A subsequent request replaces this result.
	 */
	override fn GetInstruction() uint
	{
		return instruction
	}

	/**
	 * Reports whether the last completed transaction failed. A new transaction replaces this status.
	 */
	override fn HasError() bool
	{
		return error
	}
}
