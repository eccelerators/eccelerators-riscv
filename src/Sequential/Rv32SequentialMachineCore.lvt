namespace Eccelerators.RiscV.Sequential

using Eccelerators.RiscV.Core
using Eccelerators.RiscV.Machine
using Eccelerators.RiscV.Contracts

/** Sequential specialization of the shared machine-mode composition. */
component Rv32SequentialMachineCore<
	REGISTERS: IRv32RegisterPort & new(),
	BASE_DECODER: IRv32DecodePort & new(),
	ZICSR: IRv32DecodePort & IRv32MachineCsrPort & new(flip IRv32DecodePort),
	MACHINE_DECODER: IRv32DecodePort & new(flip IRv32DecodePort),
	INTEGER: IRv32IntegerPort & new(),
	MULTIPLIER: IRv32MPort & new(),
	CUSTOM: IRv32CustomInstructionPort & new(),
	RESET_PC: uint = 0,
	REGISTER_COUNT: uint = 32,
	INSTRUCTION_ALIGNMENT: RvInstructionAlignment = RvInstructionAlignment.Word,
	INSTRUCTIONS: IRv32InstructionPort & new(flip IRv32FetchPort) = Rv32WordInstructionFetch
> : Rv32MachineCore<
		IRv32RegisterPort,
		Rv32SequentialEngine<RESET_PC, true, REGISTER_COUNT, INSTRUCTION_ALIGNMENT, INSTRUCTIONS>,
		REGISTERS,
		BASE_DECODER,
		ZICSR,
		MACHINE_DECODER,
		INTEGER,
		MULTIPLIER,
		CUSTOM
	> {}
