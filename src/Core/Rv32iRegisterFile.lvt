namespace Eccelerators.RiscV.Core

/**
 * Original array-backed architectural register file. Owns 32 words in the
 * inherited context; x0 reads zero and ignores writes. Serialize calls with
 * instruction execution and use Reset to initialize runtime processor state.
 */
component Rv32iRegisterFile: IRv32iRegisterFile
{
	// Expected: original array storage; no particular RAM mapping is promised.
	registers: uint[32]

	/**
	 * Zeros every register before returning.
	 */
	override fn Reset()
	{
		var index: int = 0

		while (index < 32) {
			this.registers[index] = 0
			index++
		}
	}

	/**
	 * Returns x1..x31, or zero for x0 and invalid indices.
	 */
	override fn Read(index: int) uint
	{
		if (index <= 0) {
			return 0
		}

		if (index >= 32) {
			return 0
		}

		return this.registers[index]
	}

	/**
	 * Writes x1..x31 before returning; ignores x0 and invalid indices.
	 */
	override fn Write(index: int, value: uint)
	{
		if (index <= 0) {
			return
		}

		if (index >= 32) {
			return
		}

		this.registers[index] = value
	}
}
