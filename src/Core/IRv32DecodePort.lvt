namespace Eccelerators.RiscV.Core

/**
 * Combinational instruction decode in the consumer's clock/reset domain.
 * Control uses RvDecoded packing and the shared core operation vocabulary.
 * Illegal encodings return zero control. Outputs have no retained state.
 */
interface IRv32DecodePort
{
	// Instruction supplied by the exclusive engine owner.
	instruction: in logic[32]

	// Complete decode outputs, sampled by the engine at its decode/execute edges.
	control: out logic[32]
	immediate: out logic[32]
}
