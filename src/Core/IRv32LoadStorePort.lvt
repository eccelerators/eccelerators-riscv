namespace Eccelerators.RiscV.Core

/**
 * One-clock-domain, one-outstanding aligned word data transaction, consumer to provider.
 * Hold every request field stable until an edge with ready=1. That edge completes
 * exactly once; sample readData/error there, then deassert request for at least one
 * edge. Provider must reject errors before effects and not accept again until request
 * falls. No cancellation; software restart drains outstanding work.
 * Byte lane zero is bits 7..0. A read ignores mask; write mask zero has no effect.
 * Atomic requests ignore write and byteEnable, require a word-aligned address, and
 * return the original word except SC, which returns zero on success and one on
 * reservation failure. The provider owns reservation state and indivisibility.
 * Acquire and release are ordering attributes that fabrics must preserve even when
 * a simple in-order memory needs no extra action.
 */
interface IRv32LoadStorePort
{
	// Consumer-owned request, stable throughout the transaction.
	request: in logic
	address: in logic[32]
	write: in logic
	byteEnable: in logic[4]
	writeData: in logic[32]
	atomic: in logic
	atomicOperation: in logic[5]
	acquire: in logic
	release: in logic

	// Provider-owned completion, held until request deasserts.
	ready: out logic
	error: out logic
	readData: out logic[32]
}
