namespace Eccelerators.RiscV.Core

/**
 * Step-driven RV32I reference wrapper with small local test memories.
 *
 * Rv32iBusCore owns the local ROM/RAM fixtures and delegates instruction
 * execution to the canonical Rv32iInjectedBusCore engine.
 * Uses the inherited clock/reset context; serialize provisioning, reset and execution
 * in one controlling process. CPU reset preserves the separately provisioned memories.
 */
component Rv32iReferenceCore
{
	// Local program capacity in words and data capacity in bytes.
	public const PROGRAM_WORDS: int = 64
	public const DATA_BYTES: int = 256

	// Owned bus-backed reference processor and its fixtures.
	core: Rv32iBusCore

	/**
	 * Owns the processor and local fixtures in the inherited clock/reset context.
	 * Construction initializes their state; provision executable content before Run or Step.
	 */
	new()
	{
		core = new Rv32iBusCore()
	}

	/**
	 * Restores reset PC, clears integer registers and releases diagnostic halt.
	 * Program and data memories are preserved; call only while execution is stopped.
	 */
	public fn Reset()
	{
		core.Reset()
	}

	/**
	 * Zeros all 64 program words before returning. Call only while execution is stopped.
	 */
	public fn ClearProgram()
	{
		core.ClearProgram()
	}

	/**
	 * Zeros the 256-byte data fixture before returning. Call only while execution is stopped.
	 */
	public fn ClearData()
	{
		core.ClearData()
	}

	/**
	 * Stores a word at instruction index 0..63; ignores indices outside that range.
	 * Provision only while execution is stopped; this argument is a word index, not a byte address.
	 */
	public fn LoadInstruction(index: int, instruction: uint)
	{
		core.LoadInstruction(index, instruction)
	}

	/**
	 * Stores a byte at local RAM offset 0..255; ignores invalid offsets.
	 * Serialize provisioning with CPU accesses; no bus address translation is applied.
	 */
	public fn LoadDataByte(address: int, value: byte)
	{
		core.LoadDataByte(address, value)
	}

	/**
	 * Returns the byte at local RAM offset 0..255, or zero for an invalid offset.
	 * Read only after any concurrent CPU access has completed.
	 */
	public fn ReadDataByte(address: int) byte
	{
		return core.ReadDataByte(address)
	}

	/**
	 * Returns x1..x31, or zero for x0 and invalid indices. Inspect after execution completes.
	 */
	public fn ReadRegister(index: int) uint
	{
		return core.ReadRegister(index)
	}

	/**
	 * Returns the current architectural PC in bytes; inspect after execution completes.
	 */
	public fn GetPc() uint
	{
		return core.GetPc()
	}

	/**
	 * Reports whether a diagnostic fault stopped instruction execution.
	 */
	public fn IsHalted() bool
	{
		return core.IsHalted()
	}

	/**
	 * Returns the last diagnostic cause from Rv32iConstants, or TRAP_NONE after reset.
	 * These reference-core codes are separate from machine mcause encodings.
	 */
	public fn GetTrapCause() int
	{
		return core.GetTrapCause()
	}

	/**
	 * Returns the saved faulting PC in bytes, or zero after reset. Check IsHalted first.
	 */
	public fn GetTrapPc() uint
	{
		return core.GetTrapPc()
	}

	/**
	 * Executes at most maxSteps instruction attempts, stopping early on a diagnostic halt.
	 * Nonpositive bounds do nothing. Provision memory first and serialize CPU control calls;
	 * scheduled completion does not imply a fixed number of clock cycles.
	 */
	public fn Run(maxSteps: int)
	{
		core.Run(maxSteps)
	}

	/**
	 * Executes one instruction attempt and returns after its effects or diagnostic fault.
	 * Does nothing while halted. Provision memory first; do not overlap reset or other CPU calls.
	 */
	public fn Step()
	{
		core.Step()
	}
}
