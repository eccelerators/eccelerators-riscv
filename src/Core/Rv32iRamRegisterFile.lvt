namespace Eccelerators.RiscV.Core

using Livt.IO

/**
 * Owns scheduled RAM for 32 architectural registers in the inherited context.
 * STYLE requests synthesis mapping; final resources depend on the tool/device.
 * Reset explicitly zeros all cells and must precede use, including after hardware
 * reset. Serialize Reset/Read/Write with instruction execution. Calls complete
 * before return but do not promise fixed or single-cycle latency.
 */
component Rv32iRamRegisterFile<STYLE: MemoryStyle = MemoryStyle.Distributed>: IRv32iRegisterFile
{
	// Expected: synchronous RAM with the explicitly selected synthesis style.
	registerMemory: Ram<uint, 32, STYLE>

	/**
	 * Constructs owned storage; Reset supplies defined initial contents.
	 */
	new()
	{
		this.registerMemory = new Ram<uint, 32, STYLE>()
	}

	/**
	 * Zeros every cell; x0 remains architecturally hardwired to zero.
	 */
	override fn Reset()
	{
		for (var index = 0; index < 32; index++) {
			this.registerMemory.Write(index, 0)
		}
	}

	/**
	 * Waits for x1..x31 data; returns zero for x0 and invalid indices.
	 */
	override fn Read(index: int) uint
	{
		if (index <= 0 || index >= 32) {
			return 0
		}

		return this.registerMemory.Read(index)
	}

	/**
	 * Completes the selected register write; ignores x0 and invalid indices.
	 */
	override fn Write(index: int, value: uint)
	{
		if (index <= 0 || index >= 32) {
			return
		}

		this.registerMemory.Write(index, value)
	}
}
