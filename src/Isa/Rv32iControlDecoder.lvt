namespace Eccelerators.RiscV.Isa

using Eccelerators.RiscV.Core

/**
 * Decodes RV32I control information into control outputs used by the cores.
 */
component Rv32iControlDecoder
{
	// Decoded instruction families; illegal is the default before a supported match.
	public const CLASS_ILLEGAL: int = 0
	public const CLASS_LUI: int = 1
	public const CLASS_AUIPC: int = 2
	public const CLASS_JAL: int = 3
	public const CLASS_JALR: int = 4
	public const CLASS_BRANCH: int = 5
	public const CLASS_LOAD: int = 6
	public const CLASS_STORE: int = 7
	public const CLASS_ALU_IMM: int = 8
	public const CLASS_ALU_REG: int = 9
	public const CLASS_FENCE: int = 10
	public const CLASS_ECALL: int = 11
	public const CLASS_EBREAK: int = 12

	// Decoded memory operations, including narrow-load signedness.
	public const LOAD_LB: int = 1
	public const LOAD_LH: int = 2
	public const LOAD_LW: int = 3
	public const LOAD_LBU: int = 4
	public const LOAD_LHU: int = 5
	public const STORE_SB: int = 1
	public const STORE_SH: int = 2
	public const STORE_SW: int = 3

	// Owned instruction-field extractor.
	fields: Rv32iInstructionFields

	// Last decoded instruction; getters remain valid until the next Decode call.
	instructionClass: int
	aluOperation: int
	branchKind: int
	loadKind: int
	storeKind: int
	legal: bool

	/**
	 * Owns the instruction-field extractor and initializes all decoded outputs to illegal/default values.
	 */
	new()
	{
		fields = new Rv32iInstructionFields()
		Reset()
	}

	/**
	 * Restores illegal classification and neutral operation selectors before decoding another word.
	 */
	fn Reset()
	{
		instructionClass = CLASS_ILLEGAL
		aluOperation = 0
		branchKind = 0
		loadKind = 0
		storeKind = 0
		legal = false
	}

	/**
	 * Replaces all decoded fields for instruction before returning.
	 * Unsupported encodings remain illegal; consume getters before the next Decode call.
	 */
	public fn Decode(instruction: uint)
	{
		var opcode: int = fields.GetOpcode(instruction)
		var funct3: int = fields.GetFunct3(instruction)
		var funct7: int = fields.GetFunct7(instruction)
		Reset()

		if (opcode == Rv32iConstants.OPCODE_LUI) {
			instructionClass = CLASS_LUI
			legal = true
			return
		}

		if (opcode == Rv32iConstants.OPCODE_AUIPC) {
			instructionClass = CLASS_AUIPC
			legal = true
			return
		}

		if (opcode == Rv32iConstants.OPCODE_JAL) {
			instructionClass = CLASS_JAL
			legal = true
			return
		}

		if (opcode == Rv32iConstants.OPCODE_JALR) {
			if (funct3 == 0) {
				instructionClass = CLASS_JALR
				legal = true
			}

			return
		}

		if (opcode == Rv32iConstants.OPCODE_BRANCH) {
			DecodeBranch(funct3)
			return
		}

		if (opcode == Rv32iConstants.OPCODE_LOAD) {
			DecodeLoad(funct3)
			return
		}

		if (opcode == Rv32iConstants.OPCODE_STORE) {
			DecodeStore(funct3)
			return
		}

		if (opcode == Rv32iConstants.OPCODE_OP_IMM) {
			DecodeAluImmediate(funct3, funct7)
			return
		}

		if (opcode == Rv32iConstants.OPCODE_OP) {
			DecodeAluRegister(funct3, funct7)
			return
		}

		if (opcode == Rv32iConstants.OPCODE_MISC_MEM) {
			if (funct3 == 0) {
				instructionClass = CLASS_FENCE
				legal = true
			}

			return
		}

		if (opcode == Rv32iConstants.OPCODE_SYSTEM) {
			if (instruction == (0x00000073 as uint)) {
				instructionClass = CLASS_ECALL
				legal = true
				return
			}

			if (instruction == (0x00100073 as uint)) {
				instructionClass = CLASS_EBREAK
				legal = true
				return
			}
		}
	}

	/**
	 * Selects a supported branch condition from funct3; unsupported selectors remain illegal.
	 */
	fn DecodeBranch(funct3: int)
	{
		instructionClass = CLASS_BRANCH

		if (funct3 == 0) {
			branchKind = Rv32iBranchUnit.BRANCH_BEQ
			legal = true
			return
		}

		if (funct3 == 1) {
			branchKind = Rv32iBranchUnit.BRANCH_BNE
			legal = true
			return
		}

		if (funct3 == 4) {
			branchKind = Rv32iBranchUnit.BRANCH_BLT
			legal = true
			return
		}

		if (funct3 == 5) {
			branchKind = Rv32iBranchUnit.BRANCH_BGE
			legal = true
			return
		}

		if (funct3 == 6) {
			branchKind = Rv32iBranchUnit.BRANCH_BLTU
			legal = true
			return
		}

		if (funct3 == 7) {
			branchKind = Rv32iBranchUnit.BRANCH_BGEU
			legal = true
			return
		}
	}

	/**
	 * Selects load width and signedness from funct3; unsupported selectors remain illegal.
	 */
	fn DecodeLoad(funct3: int)
	{
		instructionClass = CLASS_LOAD

		if (funct3 == 0) {
			loadKind = LOAD_LB
			legal = true
			return
		}

		if (funct3 == 1) {
			loadKind = LOAD_LH
			legal = true
			return
		}

		if (funct3 == 2) {
			loadKind = LOAD_LW
			legal = true
			return
		}

		if (funct3 == 4) {
			loadKind = LOAD_LBU
			legal = true
			return
		}

		if (funct3 == 5) {
			loadKind = LOAD_LHU
			legal = true
			return
		}
	}

	/**
	 * Selects store width from funct3; unsupported selectors remain illegal.
	 */
	fn DecodeStore(funct3: int)
	{
		instructionClass = CLASS_STORE

		if (funct3 == 0) {
			storeKind = STORE_SB
			legal = true
			return
		}

		if (funct3 == 1) {
			storeKind = STORE_SH
			legal = true
			return
		}

		if (funct3 == 2) {
			storeKind = STORE_SW
			legal = true
			return
		}
	}

	/**
	 * Selects an immediate ALU operation and checks reserved shift encodings before marking it legal.
	 */
	fn DecodeAluImmediate(funct3: int, funct7: int)
	{
		instructionClass = CLASS_ALU_IMM

		if (funct3 == Rv32iConstants.FUNCT3_ADD_SUB) {
			aluOperation = Rv32iAlu.OP_ADD
			legal = true
			return
		}

		if (funct3 == Rv32iConstants.FUNCT3_SLL) {
			if (funct7 == Rv32iConstants.FUNCT7_BASE) {
				aluOperation = Rv32iAlu.OP_SLL
				legal = true
			}

			return
		}

		if (funct3 == Rv32iConstants.FUNCT3_SLT) {
			aluOperation = Rv32iAlu.OP_SLT
			legal = true
			return
		}

		if (funct3 == Rv32iConstants.FUNCT3_SLTU) {
			aluOperation = Rv32iAlu.OP_SLTU
			legal = true
			return
		}

		if (funct3 == Rv32iConstants.FUNCT3_XOR) {
			aluOperation = Rv32iAlu.OP_XOR
			legal = true
			return
		}

		if (funct3 == Rv32iConstants.FUNCT3_SRL_SRA) {
			if (funct7 == Rv32iConstants.FUNCT7_BASE) {
				aluOperation = Rv32iAlu.OP_SRL
				legal = true
				return
			}

			if (funct7 == Rv32iConstants.FUNCT7_SUB_SRA) {
				aluOperation = Rv32iAlu.OP_SRA
				legal = true
				return
			}
		}

		if (funct3 == Rv32iConstants.FUNCT3_OR) {
			aluOperation = Rv32iAlu.OP_OR
			legal = true
			return
		}

		if (funct3 == Rv32iConstants.FUNCT3_AND) {
			aluOperation = Rv32iAlu.OP_AND
			legal = true
			return
		}
	}

	/**
	 * Selects an RV32I register ALU operation; rejects unsupported funct3/funct7 combinations.
	 */
	fn DecodeAluRegister(funct3: int, funct7: int)
	{
		instructionClass = CLASS_ALU_REG

		if (funct3 == Rv32iConstants.FUNCT3_ADD_SUB) {
			if (funct7 == Rv32iConstants.FUNCT7_BASE) {
				aluOperation = Rv32iAlu.OP_ADD
				legal = true
				return
			}

			if (funct7 == Rv32iConstants.FUNCT7_SUB_SRA) {
				aluOperation = Rv32iAlu.OP_SUB
				legal = true
				return
			}
		}

		if (funct3 == Rv32iConstants.FUNCT3_SLL && funct7 == Rv32iConstants.FUNCT7_BASE) {
			aluOperation = Rv32iAlu.OP_SLL
			legal = true
			return
		}

		if (funct3 == Rv32iConstants.FUNCT3_SLT && funct7 == Rv32iConstants.FUNCT7_BASE) {
			aluOperation = Rv32iAlu.OP_SLT
			legal = true
			return
		}

		if (funct3 == Rv32iConstants.FUNCT3_SLTU && funct7 == Rv32iConstants.FUNCT7_BASE) {
			aluOperation = Rv32iAlu.OP_SLTU
			legal = true
			return
		}

		if (funct3 == Rv32iConstants.FUNCT3_XOR && funct7 == Rv32iConstants.FUNCT7_BASE) {
			aluOperation = Rv32iAlu.OP_XOR
			legal = true
			return
		}

		if (funct3 == Rv32iConstants.FUNCT3_SRL_SRA) {
			if (funct7 == Rv32iConstants.FUNCT7_BASE) {
				aluOperation = Rv32iAlu.OP_SRL
				legal = true
				return
			}

			if (funct7 == Rv32iConstants.FUNCT7_SUB_SRA) {
				aluOperation = Rv32iAlu.OP_SRA
				legal = true
				return
			}
		}

		if (funct3 == Rv32iConstants.FUNCT3_OR && funct7 == Rv32iConstants.FUNCT7_BASE) {
			aluOperation = Rv32iAlu.OP_OR
			legal = true
			return
		}

		if (funct3 == Rv32iConstants.FUNCT3_AND && funct7 == Rv32iConstants.FUNCT7_BASE) {
			aluOperation = Rv32iAlu.OP_AND
			legal = true
			return
		}
	}

	/**
	 * Reports whether the most recently decoded instruction has a supported encoding.
	 */
	public fn IsLegal() bool
	{
		return legal
	}

	/**
	 * Returns the most recent CLASS_* selector; CLASS_ILLEGAL denotes an unsupported encoding.
	 */
	public fn GetInstructionClass() int
	{
		return instructionClass
	}

	/**
	 * Returns the OP_* selector for the most recent ALU instruction.
	 * Use only after IsLegal and an appropriate instruction-class check.
	 */
	public fn GetAluOperation() int
	{
		return aluOperation
	}

	/**
	 * Returns the most recent BRANCH_* selector; non-branch decodes reset it to BRANCH_NONE.
	 */
	public fn GetBranchKind() int
	{
		return branchKind
	}

	/**
	 * Returns the most recent LOAD_* selector; non-load decodes reset it to zero.
	 */
	public fn GetLoadKind() int
	{
		return loadKind
	}

	/**
	 * Returns the most recent STORE_* selector; non-store decodes reset it to zero.
	 */
	public fn GetStoreKind() int
	{
		return storeKind
	}
}
