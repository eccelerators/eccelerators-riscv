namespace Eccelerators.RiscV.Isa

/**
 * Pure 32-bit word helpers used by RV32I components.
 */
class Rv32iWord
{
	public static fn SignExtend(value: uint, bitCount: int) uint
	{
		var masked: uint = value
		var signBit: uint = 0
		var extendMask: uint = 0
		var signShift: int = bitCount - 1

		if (bitCount >= 32) {
			return value
		}

		signBit = 1 as uint
		signBit = signBit << signShift
		masked = value & (signBit + signBit - 1)

		if ((masked & signBit) == 0) {
			return masked
		}

		extendMask = 0xffffffff as uint
		extendMask = extendMask << bitCount
		return masked | extendMask
	}

	public static fn IsSignedLessThan(leftValue: uint, rightValue: uint) bool
	{
		var leftSign: bool = (leftValue & (0x80000000 as uint)) != 0
		var rightSign: bool = (rightValue & (0x80000000 as uint)) != 0

		if (leftSign == true && rightSign == false) {
			return true
		}

		if (leftSign == false && rightSign == true) {
			return false
		}

		return leftValue < rightValue
	}

	public static fn ArithmeticShiftRight(value: uint, amount: int) uint
	{
		var shifted: uint = value
		var fillMask: uint = 0
		var isNegative: bool = (value & (0x80000000 as uint)) != 0
		var fillShift: int = 32 - amount

		if (amount <= 0) {
			return value
		}

		shifted = value >> amount

		if (isNegative == false) {
			return shifted
		}

		fillMask = 0xffffffff as uint
		fillMask = fillMask << fillShift
		return shifted | fillMask
	}
}
