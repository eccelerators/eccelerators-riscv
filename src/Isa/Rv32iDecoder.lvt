namespace Eccelerators.RiscV.Isa

using Eccelerators.RiscV.Core

/**
 * Combinational decoder component, sharing pure semantics with other engines/tests.
 * Outputs continuously reflect instruction; the owner controls sampling boundaries.
 */
component Rv32iDecoder : IRv32DecodePort
{
	// Concrete implementation capabilities used by the composition contract.
	public const CAPABILITIES: uint = Rv32iDecode.CAPABILITIES

	/**
	 * Continuously computes decoded control and immediate without state.
	 */
	process Decode[]()
	{
		control = Rv32iDecode.Control(instruction as uint) as logic[32]
		immediate = Rv32iDecode.Immediate(instruction as uint) as logic[32]
	}
}
