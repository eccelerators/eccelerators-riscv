namespace Eccelerators.RiscV.Isa

using Eccelerators.RiscV.Core

/**
 * Constant port termination for an RV32I-only composition; owns no arithmetic
 * state. Its engine must disable M-family dispatch and decoder acceptance.
 */
component Rv32NoMUnit : IRv32MPort
{
	// No supported M-family operations.
	public const CAPABILITIES: uint = 0

	/**
	 * Produces no completion; there is no instruction provider behind this port.
	 */
	process Drive[]()
	{
		ready = 0b0
		result = 0
	}
}
