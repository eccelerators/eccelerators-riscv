	process Calculate[]()
	{
		base.operation = operation
		base.left = left
		base.right = right
		result = base.result

		if (operation as uint >= Rv32BitmanipOperations.ANDN
			&& operation as uint <= Rv32BitmanipOperations.REV8) {
			result = Rv32BitmanipSemantics.Execute(
				operation as uint,
				left as uint,
				right as uint
			) as logic[32]
		}
	}
}

