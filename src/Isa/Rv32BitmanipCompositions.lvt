/** No-argument RV32I + Zba + Zbb + Zbs decoder composition. */
component Rv32iBitmanipDecoder : IRv32DecodePort
{
	public const CAPABILITIES: uint = Rv32iDecode.CAPABILITIES
		| Rv32BitmanipOperations.ZBA_CAPABILITY
		| Rv32BitmanipOperations.ZBB_CAPABILITY
		| Rv32BitmanipOperations.ZBS_CAPABILITY
	base: Rv32iDecoder
	zba: Rv32ZbaDecoder
	zbb: Rv32ZbbDecoder
	zbs: Rv32ZbsDecoder

	new()
	{
		base = new Rv32iDecoder()
		zba = new Rv32ZbaDecoder(base)
		zbb = new Rv32ZbbDecoder(zba)
		zbs = new Rv32ZbsDecoder(zbb)
	}

	process Connect[]()
	{
		zbs.instruction = instruction
		control = zbs.control
		immediate = zbs.immediate
	}
}

/** No-argument RV32I + Zba integer composition. */
component Rv32iZbaIntegerUnit : IRv32IntegerPort
{
	base: Rv32iIntegerUnit
	extension: Rv32ZbaIntegerUnit

	new()
	{
		base = new Rv32iIntegerUnit()
		extension = new Rv32ZbaIntegerUnit(base)
	}

	process Connect[]()
	{
		extension.operation = operation
		extension.left = left
		extension.right = right
		result = extension.result
	}
}

