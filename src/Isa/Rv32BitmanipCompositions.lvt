namespace Eccelerators.RiscV.Isa

using Eccelerators.RiscV.Core

/** No-argument RV32I + Zba decoder composition for general cores. */
component Rv32iZbaDecoder : IRv32DecodePort
{
	base: Rv32iDecoder
	extension: Rv32ZbaDecoder

	new()
	{
		base = new Rv32iDecoder()
		extension = new Rv32ZbaDecoder(base)
	}

	process Connect[]()
	{
		extension.instruction = instruction
		control = extension.control
		immediate = extension.immediate
	}
}

