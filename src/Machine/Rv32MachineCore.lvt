namespace Eccelerators.RiscV.Machine

using Eccelerators.RiscV.Core

/**
 * General owned-provider machine-mode composition. ZICSR is one shared decoder
 * and CSR state owner: MACHINE_DECODER overlays it for execution while the engine
 * borrows the same instance through IRv32CsrPort. All choices are elaboration-time.
 */
component Rv32MachineCore<
	REGISTER_PORT: interface,
	ENGINE: IRv32ControlPort & new(
		flip REGISTER_PORT,
		flip IRv32FetchPort,
		flip IRv32LoadStorePort,
		flip IRv32DecodePort,
		flip IRv32IntegerPort,
		flip IRv32MPort,
		flip IRv32CsrPort,
		flip IRv32CustomInstructionPort
	),
	REGISTERS: REGISTER_PORT & new(),
	BASE_DECODER: IRv32DecodePort & new(),
	ZICSR: IRv32DecodePort & IRv32MachineCsrPort & new(flip IRv32DecodePort),
	MACHINE_DECODER: IRv32DecodePort & new(flip IRv32DecodePort),
	INTEGER: IRv32IntegerPort & new(),
	MULTIPLIER: IRv32MPort & new(),
	CUSTOM: IRv32CustomInstructionPort & new()
> : IRv32MachineControlPort
{
	registers: REGISTERS
	baseDecoder: BASE_DECODER
	zicsr: ZICSR
	decoder: MACHINE_DECODER
	integer: INTEGER
	multiplier: MULTIPLIER
	custom: CUSTOM
	engine: ENGINE

	/**
	 * Constructs the decoder chain and each selected execution provider exactly once.
	 */
	new(fetch: flip IRv32FetchPort, loadStore: flip IRv32LoadStorePort)
	{
		registers = new REGISTERS()
		baseDecoder = new BASE_DECODER()
		zicsr = new ZICSR(baseDecoder)
		decoder = new MACHINE_DECODER(zicsr)
		integer = new INTEGER()
		multiplier = new MULTIPLIER()
		custom = new CUSTOM()
		engine = new ENGINE(
			registers,
			fetch,
			loadStore,
			decoder,
			integer,
			multiplier,
			zicsr,
			custom
		)
	}

	/**
	 * Forwards machine inputs and the standard control contract without added state.
	 */
	process Connect[]()
	{
		zicsr.timerPending = timerPending
		zicsr.externalPending = externalPending
		engine.run = run
		engine.stepRequest = stepRequest
		engine.restartRequest = restartRequest
		stepAck = engine.stepAck
		restartAck = engine.restartAck
		idle = engine.idle
		halted = engine.halted
		pc = engine.pc
		faultCause = engine.faultCause
		faultValue = engine.faultValue
		trapped = engine.trapped
		trapPc = engine.trapPc
		trapCause = engine.trapCause
		trapValue = engine.trapValue
		retired = engine.retired
		retiredPc = engine.retiredPc
		retiredInstruction = engine.retiredInstruction
		retiredRd = engine.retiredRd
		retiredValue = engine.retiredValue
	}
}
