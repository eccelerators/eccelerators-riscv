namespace Eccelerators.RiscV.Presets

using Eccelerators.RiscV.Isa
using Eccelerators.RiscV.Core
using Eccelerators.RiscV.Pipeline
using Eccelerators.RiscV.Storage
using Livt.IO

/**
 * Qualified RV32I + Zmmul + Zicsr machine preset with a four-stage pipeline.
 * The shared machine core owns all providers; this preset selects and qualifies them.
 */
component Rv32iZmmulPipelineMachineCore<
	MULTIPLIER: IRv32ZmmulPort & new(),
	RESET_PC: uint = 0,
	REGISTER_FILE_STYLE: MemoryStyle = MemoryStyle.Block
> : Rv32PipelineMachineCore<
	Rv32DualReadRegisterBank<REGISTER_FILE_STYLE>,
	Rv32iZmmulDecoder,
	Rv32ZicsrComposition<0, true, true>,
	Rv32MachineDecoder,
	Rv32iIntegerUnit,
	MULTIPLIER,
	Rv32NoCustomInstruction,
	RESET_PC
>
{
	const DECODED_RV32I: uint = Rv32iZmmulDecoder.CAPABILITIES & Rv32iDecode.CAPABILITIES
	const PROVIDED_RV32I: uint = Rv32iIntegerUnit.CAPABILITIES & Rv32iOperations.INTEGER_CAPABILITY
	const ROUTED_BY_ENGINE: uint = Rv32PipelineEngine.CAPABILITIES & Rv32PipelineEngine.CAPABILITIES
	const ROUTE_CONFLICT: uint = Rv32iOperations.INTEGER_CAPABILITY & Rv32PipelineEngine.CAPABILITIES
	const ROUTED_RV32I: uint = Rv32iOperations.INTEGER_CAPABILITY | Rv32PipelineEngine.CAPABILITIES
	const DECODED_ZMMUL: uint = Rv32iZmmulDecoder.CAPABILITIES & Rv32MultiplyOperations.CAPABILITY
	const PROVIDED_ZMMUL: uint = Rv32IterativeMultiplier.CAPABILITIES & Rv32MultiplyOperations.CAPABILITY
	const DECODED_TRAPS: uint = Rv32MachineDecoder.CAPABILITIES & Rv32TrapOperations.CAPABILITY
	const PROVIDED_TRAPS: uint = Rv32ZicsrComposition.TRAP_CAPABILITIES & Rv32TrapOperations.CAPABILITY

	static assert DECODED_RV32I == Rv32iDecode.CAPABILITIES, "Decoder lacks RV32I operations"
	static assert PROVIDED_RV32I == Rv32iOperations.INTEGER_CAPABILITY,
		"Integer provider lacks RV32I operations"
	static assert ROUTED_BY_ENGINE == Rv32PipelineEngine.CAPABILITIES,
		"Engine lacks routed operations"
	static assert ROUTE_CONFLICT == 0, "Ambiguous RV32I operation dispatch"
	static assert ROUTED_RV32I == Rv32iDecode.CAPABILITIES, "RV32I dispatch is incomplete"
	static assert DECODED_ZMMUL == Rv32MultiplyOperations.CAPABILITY,
		"Decoder lacks Zmmul operations"
	static assert PROVIDED_ZMMUL == Rv32MultiplyOperations.CAPABILITY,
		"Multiplier lacks Zmmul operations"
	static assert DECODED_TRAPS == Rv32TrapOperations.CAPABILITY,
		"Decoder lacks machine trap operations"
	static assert PROVIDED_TRAPS == Rv32TrapOperations.CAPABILITY,
		"Zicsr provider lacks machine trap operations"

	static assert Rv32DualReadRegisterBank.READ_PORTS == 2,
		"Pipeline register provider requires two read ports"
	static assert Rv32DualReadRegisterBank.READ_LATENCY == 1,
		"Pipeline register reads require one edge"
	static assert Rv32DualReadRegisterBank.INDEPENDENT_WRITE,
		"Pipeline register provider requires an independent write port"
	static assert Rv32DualReadRegisterBank.WRITE_FORWARDING,
		"Pipeline register provider requires write forwarding"
}
