namespace Eccelerators.RiscV.Presets

using Eccelerators.RiscV.Isa
using Eccelerators.RiscV.Sequential
using Eccelerators.RiscV.Core
using Eccelerators.RiscV.Machine
using Eccelerators.RiscV.Storage
using Eccelerators.RiscV.Contracts
using Livt.IO

/**
 * Named RV32I + Zba + Zbb + Zbs sequential composition using the general owned-provider core.
 * The single-port register bank uses BRAM by default. The caller owns
 * instruction and data providers in the same clock/reset domain. Qualification
 * applies to documented providers and targets, not arbitrary attached buses.
 */
component Rv32iBitmanipSequentialCore<RESET_PC: uint = 0,
	REGISTER_FILE_STYLE: MemoryStyle = MemoryStyle.Block> : IRv32ControlPort
{
	const BITMANIP: uint = Rv32BitmanipOperations.ZBA_CAPABILITY
		| Rv32BitmanipOperations.ZBB_CAPABILITY | Rv32BitmanipOperations.ZBS_CAPABILITY
	static assert (Rv32iBitmanipDecoder.CAPABILITIES & BITMANIP) == BITMANIP,
		"Decoder lacks a selected bit-manipulation subset"
	static assert (Rv32iBitmanipIntegerUnit.CAPABILITIES & BITMANIP) == BITMANIP,
		"Integer provider lacks a selected bit-manipulation subset"
	core: Rv32SequentialCore<
		Rv32RegisterBank<REGISTER_FILE_STYLE>,
		Rv32iBitmanipDecoder,
		Rv32iBitmanipIntegerUnit,
		Rv32NoMUnit,
		Rv32NoCsrs,
		Rv32NoCustomInstruction,
		RESET_PC
	>

	// Elaboration-only ISA coverage and timing checks for this qualified preset.
	coverage: RvOperationCoverage<Rv32iDecode.CAPABILITIES, Rv32iBitmanipDecoder.CAPABILITIES,
		Rv32iBitmanipIntegerUnit.CAPABILITIES, Rv32SequentialEngine.CAPABILITIES,
		Rv32iOperations.INTEGER_CAPABILITY, Rv32SequentialEngine.CAPABILITIES>
	timing: RvTimingContract<1, 2, true, true, true, 1, 1, true, true, true, false>

	/**
	 * Selects all owned providers at elaboration and borrows the caller's buses.
	 */
	new(fetch: flip IRv32FetchPort, loadStore: flip IRv32LoadStorePort)
	{
		core = new Rv32SequentialCore<
			Rv32RegisterBank<REGISTER_FILE_STYLE>,
			Rv32iBitmanipDecoder,
			Rv32iBitmanipIntegerUnit,
			Rv32NoMUnit,
			Rv32NoCsrs,
			Rv32NoCustomInstruction,
			RESET_PC
		>(fetch, loadStore)
		coverage = new RvOperationCoverage<Rv32iDecode.CAPABILITIES, Rv32iBitmanipDecoder.CAPABILITIES,
			Rv32iBitmanipIntegerUnit.CAPABILITIES, Rv32SequentialEngine.CAPABILITIES,
			Rv32iOperations.INTEGER_CAPABILITY, Rv32SequentialEngine.CAPABILITIES>()
		timing = new RvTimingContract<1, 2, true, true, true, 1, 1, true, true, true, false>()
	}

	/**
	 * Pure forwarding preserves the general core's control and retirement contract.
	 */
	process Connect[]()
	{
		core.run = run
		core.stepRequest = stepRequest
		core.restartRequest = restartRequest
		stepAck = core.stepAck
		restartAck = core.restartAck
		idle = core.idle
		halted = core.halted
		pc = core.pc
		faultCause = core.faultCause
		faultValue = core.faultValue
		trapped = core.trapped
		trapPc = core.trapPc
		trapCause = core.trapCause
		trapValue = core.trapValue
		retired = core.retired
		retiredPc = core.retiredPc
		retiredInstruction = core.retiredInstruction
		retiredRd = core.retiredRd
		retiredValue = core.retiredValue
	}
}
